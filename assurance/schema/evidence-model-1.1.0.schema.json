    "ProofObligationRecord":{"type":"object","additionalProperties":false,"required":["id","claim_id","required_outcome","outcome","model_id","production_code_ids","bounds","unsupported_constructs"],"properties":{"id":{"$ref":"#/$defs/StableId"},"claim_id":{"$ref":"#/$defs/StableId"},"required_outcome":{"$ref":"#/$defs/LatticeOutcome"},"outcome":{"$ref":"#/$defs/LatticeOutcome"},"model_id":{"$ref":"#/$defs/StableId"},"production_code_ids":{"type":"array","items":{"type":"string","pattern":"^(?:[A-Za-z0-9_][A-Za-z0-9._-]*/)*[A-Za-z0-9_][A-Za-z0-9._-]*#[A-Za-z_][A-Za-z0-9_.:-]*$"}},"bounds":{"type":"array","items":{"type":"string"}},"unsupported_constructs":{"type":"array","items":{"type":"string"}}}},
