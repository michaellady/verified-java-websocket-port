    "AssuranceProfile":{"type":"object","additionalProperties":false,"required":["label","required_artifact_types","trusted_computing_base","disclosures","prohibited_inferences","failure_states","expiry_rule","freshness_rule","readiness_ceiling"],"properties":{"label":{"enum":["observed","differential","bounded","proved-model","proved-production/refinement"]},"required_artifact_types":{"$ref":"#/$defs/NonEmptyStrings"},"trusted_computing_base":{"$ref":"#/$defs/NonEmptyStrings"},"disclosures":{"$ref":"#/$defs/NonEmptyStrings"},"prohibited_inferences":{"$ref":"#/$defs/NonEmptyStrings"},"failure_states":{"$ref":"#/$defs/NonEmptyStrings"},"expiry_rule":{"type":"string","minLength":1},"freshness_rule":{"type":"string","minLength":1},"readiness_ceiling":{"enum":["LAB","CANDIDATE","PUBLISHED"]}},"allOf":[{"if":{"properties":{"label":{"const":"observed"}}},"then":{"properties":{"required_artifact_types":{"contains":{"const":"EvidenceRun"}}}}},{"if":{"properties":{"label":{"const":"differential"}}},"then":{"properties":{"required_artifact_types":{"allOf":[{"contains":{"const":"EvidenceRun"}},{"contains":{"const":"Trace"}},{"contains":{"const":"Oracle"}}]}}}},{"if":{"properties":{"label":{"enum":["bounded","proved-model"]}}},"then":{"properties":{"required_artifact_types":{"allOf":[{"contains":{"const":"EvidenceRun"}},{"contains":{"const":"ProofObligation"}},{"contains":{"const":"Model"}}]}}}},{"if":{"properties":{"label":{"const":"proved-production/refinement"}}},"then":{"properties":{"required_artifact_types":{"allOf":[{"contains":{"const":"EvidenceRun"}},{"contains":{"const":"Trace"}},{"contains":{"const":"MutationResult"}},{"contains":{"const":"BenchmarkRun"}},{"contains":{"const":"ProofObligation"}},{"contains":{"const":"Review"}},{"contains":{"const":"Model"}}]}}}}]},
