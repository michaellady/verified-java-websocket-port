    "MigrationMapRow":{"type":"object","additionalProperties":false,"required":["id","java_semantic_id","java_signature","rust_semantic_id","rust_resolver","applicability_conditions","known_non_equivalent_cases","source_revision","detection_query","port_slice_id","touched_files","specification_ids","observed_behavior_ids","oracle_ids","vector_ids","property_claim_ids","formal_claim_ids","evidence_ids","status","lookup_strength"],"properties":{"id":{"$ref":"#/$defs/StableId"},"java_semantic_id":{"type":"string"},"java_signature":{"type":"string"},"rust_semantic_id":{"type":"string"},"rust_resolver":{"enum":["rust-analyzer","reviewed-glancer"]},"applicability_conditions":{"$ref":"#/$defs/NonEmptyStrings"},"known_non_equivalent_cases":{"$ref":"#/$defs/NonEmptyStrings"},"source_revision":{"type":"string"},"detection_query":{"type":"string"},"port_slice_id":{"type":"string"},"touched_files":{"$ref":"#/$defs/NonEmptyStrings"},"specification_ids":{"$ref":"#/$defs/NonEmptyStrings"},"observed_behavior_ids":{"$ref":"#/$defs/NonEmptyStrings"},"oracle_ids":{"$ref":"#/$defs/NonEmptyStrings"},"vector_ids":{"$ref":"#/$defs/NonEmptyStrings"},"property_claim_ids":{"$ref":"#/$defs/NonEmptyStrings"},"formal_claim_ids":{"$ref":"#/$defs/NonEmptyStrings"},"evidence_ids":{"$ref":"#/$defs/NonEmptyStrings"},"status":{"type":"string"},"lookup_strength":{"enum":["semantic","ast-fallback","grep-fallback"]}}},
