{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/michaellady/verified-java-to-rust/schemas/developer-tool-run-1.0.0.schema.json",
  "title":"DeveloperToolRun 1.0.0 (non-assurance)",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","entity_type","run_id","qualification_id","profile_id","language","tool","workspace_profile_id","source_revision","target","features","client","corpus_id","execution_evidence","episodes","measurements","capability_observations","reliability","disagreements","authoritative_result_source","build_authoritative","assurance_claims","gate_effects","reproduction","limitations"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "entity_type":{"const":"DeveloperToolRun"},
    "run_id":{"$ref":"#/$defs/id"},"qualification_id":{"$ref":"#/$defs/id"},"profile_id":{"$ref":"#/$defs/id"},
    "language":{"enum":["java","rust"]},
    "tool":{"$ref":"#/$defs/tool"},
    "workspace_profile_id":{"$ref":"#/$defs/id"},
    "source_revision":{"$ref":"#/$defs/sha256"},
    "target":{"$ref":"#/$defs/text"},
    "features":{"$ref":"#/$defs/strings"},
    "client":{"$ref":"#/$defs/text"},
    "corpus_id":{"$ref":"#/$defs/id"},
    "execution_evidence":{"$ref":"#/$defs/artifactRef"},
    "episodes":{"type":"array","minItems":4,"maxItems":4,"x-foundation-unique-item-property":"cache_state","items":{"$ref":"#/$defs/episode"}},
    "measurements":{"$ref":"#/$defs/measurements"},
    "capability_observations":{"type":"array","minItems":6,"x-foundation-unique-item-property":"capability","items":{"$ref":"#/$defs/capability"}},
    "reliability":{"$ref":"#/$defs/reliability"},
    "disagreements":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/disagreement"}},
    "authoritative_result_source":{"$ref":"#/$defs/text"},
    "build_authoritative":{"const":true},
    "assurance_claims":{"type":"array","maxItems":0},
    "gate_effects":{"type":"array","maxItems":0},
    "reproduction":{"$ref":"#/$defs/reproduction"},
    "limitations":{"$ref":"#/$defs/strings"}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "text":{"type":"string","minLength":1,"pattern":"\\S"},
    "sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "path":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"},
    "artifactRef":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"$ref":"#/$defs/path"},"sha256":{"$ref":"#/$defs/sha256"}}},
    "commit":{"type":["string","null"],"pattern":"^[0-9a-f]{40}$"},
    "strings":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
    "tool":{"type":"object","additionalProperties":false,"required":["name","version","commit","artifact_sha256","installation_provenance"],"properties":{"name":{"$ref":"#/$defs/text"},"version":{"$ref":"#/$defs/text"},"commit":{"$ref":"#/$defs/commit"},"artifact_sha256":{"$ref":"#/$defs/sha256"},"installation_provenance":{"$ref":"#/$defs/text"}}},
    "episode":{"type":"object","additionalProperties":false,"required":["cache_state","sequence","observation_status","outcome","failure","recovery"],"properties":{"cache_state":{"enum":["cold","warm","invalidated","corrupted"]},"sequence":{"type":"integer","minimum":1,"maximum":4},"observation_status":{"enum":["OBSERVED","BLOCKED_UNAVAILABLE"]},"outcome":{"enum":["PASS","FAIL","NOT_OBSERVED"]},"failure":{"type":"string"},"recovery":{"$ref":"#/$defs/text"}}},
    "nullableMetric":{"type":["integer","null"],"minimum":0},
    "measurements":{"type":"object","additionalProperties":false,"required":["cold_readiness_ms","warm_readiness_ms","initial_index_ms","reindex_ms","idle_rss_bytes","peak_rss_bytes","cache_size_bytes","agent_elapsed_ms","tool_calls","incorrect_edits","recovery_work_items"],"properties":{"cold_readiness_ms":{"$ref":"#/$defs/nullableMetric"},"warm_readiness_ms":{"$ref":"#/$defs/nullableMetric"},"initial_index_ms":{"$ref":"#/$defs/nullableMetric"},"reindex_ms":{"$ref":"#/$defs/nullableMetric"},"idle_rss_bytes":{"$ref":"#/$defs/nullableMetric"},"peak_rss_bytes":{"$ref":"#/$defs/nullableMetric"},"cache_size_bytes":{"$ref":"#/$defs/nullableMetric"},"agent_elapsed_ms":{"$ref":"#/$defs/nullableMetric"},"tool_calls":{"$ref":"#/$defs/nullableMetric"},"incorrect_edits":{"$ref":"#/$defs/nullableMetric"},"recovery_work_items":{"$ref":"#/$defs/nullableMetric"}}},
    "capability":{"type":"object","additionalProperties":false,"required":["capability","status"],"properties":{"capability":{"$ref":"#/$defs/id"},"status":{"enum":["PASS","FAIL","STALE","NOT_OBSERVED"]}}},
    "reliability":{"type":"object","additionalProperties":false,"required":["crashes","hangs","corruption","stale_results","recovery"],"properties":{"crashes":{"$ref":"#/$defs/status"},"hangs":{"$ref":"#/$defs/status"},"corruption":{"$ref":"#/$defs/status"},"stale_results":{"$ref":"#/$defs/status"},"recovery":{"$ref":"#/$defs/status"}}},
    "status":{"enum":["PASS","FAIL","NOT_OBSERVED"]},
    "disagreement":{"type":"object","additionalProperties":false,"required":["query_id","lsp_result","build_result","resolution"],"properties":{"query_id":{"$ref":"#/$defs/id"},"lsp_result":{"$ref":"#/$defs/text"},"build_result":{"$ref":"#/$defs/text"},"resolution":{"const":"AUTHORITATIVE_BUILD_WINS"}}},
    "inputFixture":{"type":"object","additionalProperties":false,"required":["sha256","access"],"properties":{"sha256":{"$ref":"#/$defs/sha256"},"access":{"const":"READ_ONLY"}}},
    "executionWorkspace":{"type":"object","additionalProperties":false,"required":["initial_sha256","mode"],"properties":{"initial_sha256":{"$ref":"#/$defs/sha256"},"mode":{"const":"WRITABLE_DISPOSABLE_COPY"}}},
    "reproduction":{"type":"object","additionalProperties":false,"required":["mode","procedure","network","secrets","input_fixture","execution_workspace"],"properties":{"mode":{"enum":["EXECUTED","BLOCKED"]},"procedure":{"$ref":"#/$defs/text"},"network":{"const":"DENY"},"secrets":{"const":"NONE"},"input_fixture":{"$ref":"#/$defs/inputFixture"},"execution_workspace":{"$ref":"#/$defs/executionWorkspace"}}}
  }
}
