{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/michaellady/verified-java-to-rust/schemas/language-intelligence-profile-1.0.0.schema.json",
  "title":"Language-intelligence qualification 1.0.0",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","qualification_id","laboratory_id","program_snapshot_id","captured_at","corpus","authoritative_build","java_profile","rust_profiles","profile_switch_artifact","prohibited_gate_effects","assurance_claims"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"qualification_id":{"$ref":"#/$defs/id"},"laboratory_id":{"$ref":"#/$defs/id"},"program_snapshot_id":{"$ref":"#/$defs/id"},"captured_at":{"type":"string","format":"date-time"},
    "corpus":{"$ref":"#/$defs/artifactRefWithID"},
    "authoritative_build":{"type":"object","additionalProperties":false,"required":["java","rust","lsp_may_override"],"properties":{"java":{"$ref":"#/$defs/text"},"rust":{"$ref":"#/$defs/text"},"lsp_may_override":{"const":false}}},
    "java_profile":{"$ref":"#/$defs/javaProfile"},
    "rust_profiles":{"type":"array","minItems":2,"maxItems":2,"x-foundation-unique-item-property":"profile_id","items":{"$ref":"#/$defs/rustProfile"}},
    "profile_switch_artifact":{"$ref":"#/$defs/artifactRef"},
    "prohibited_gate_effects":{"type":"array","minItems":8,"maxItems":8,"uniqueItems":true,"items":{"enum":["equivalence","formal","mutation","unsafe-code","held-out","performance","security","release"]}},
    "assurance_claims":{"type":"array","maxItems":0}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},"text":{"type":"string","minLength":1,"pattern":"\\S"},"sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"commit":{"type":["string","null"],"pattern":"^[0-9a-f]{40}$"},"path":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"},"strings":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
    "artifactRef":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"$ref":"#/$defs/path"},"sha256":{"$ref":"#/$defs/sha256"}}},
    "artifactRefWithID":{"type":"object","additionalProperties":false,"required":["id","manifest_path","sha256"],"properties":{"id":{"$ref":"#/$defs/id"},"manifest_path":{"$ref":"#/$defs/path"},"sha256":{"$ref":"#/$defs/sha256"}}},
    "tool":{"type":"object","additionalProperties":false,"required":["name","version","commit","artifact_name","artifact_sha256","artifact_size_bytes","provenance_url","digest_verified","installed","auto_update_disabled"],"properties":{"name":{"$ref":"#/$defs/text"},"version":{"$ref":"#/$defs/text"},"commit":{"$ref":"#/$defs/commit"},"artifact_name":{"$ref":"#/$defs/text"},"artifact_sha256":{"$ref":"#/$defs/sha256"},"artifact_size_bytes":{"type":"integer","minimum":1},"provenance_url":{"type":"string","format":"uri","pattern":"^https://"},"digest_verified":{"const":true},"installed":{"type":"boolean"},"auto_update_disabled":{"const":true}}},
    "isolation":{"type":"object","additionalProperties":false,"required":["workspace_data_dir","cache_dir","cache_shared"],"properties":{"workspace_data_dir":{"$ref":"#/$defs/path"},"cache_dir":{"$ref":"#/$defs/path"},"cache_shared":{"const":false}}},
    "javaProfile":{"type":"object","additionalProperties":false,"required":["profile_id","mandatory","tool","launch_jdk","project_jdk","isolation","build_import","client","corpus_id","navigation_capabilities","failure_observations","run_artifact","qualification_outcome"],"properties":{"profile_id":{"$ref":"#/$defs/id"},"mandatory":{"const":true},"tool":{"$ref":"#/$defs/tool"},"launch_jdk":{"type":"object","additionalProperties":false,"required":["required","selected_version","executable_sha256","status"],"properties":{"required":{"const":"21-or-newer"},"selected_version":{"type":["string","null"]},"executable_sha256":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},"status":{"enum":["AVAILABLE","MISSING"]}}},"project_jdk":{"type":"object","additionalProperties":false,"required":["vendor","version","java_sha256","javac_sha256","authoritative"],"properties":{"vendor":{"$ref":"#/$defs/text"},"version":{"$ref":"#/$defs/text"},"java_sha256":{"$ref":"#/$defs/sha256"},"javac_sha256":{"$ref":"#/$defs/sha256"},"authoritative":{"const":true}}},"isolation":{"$ref":"#/$defs/isolation"},"build_import":{"type":"object","additionalProperties":false,"required":["system","version","status","network","annotation_processors","classpath","features_and_profiles"],"properties":{"system":{"enum":["Maven","Gradle"]},"version":{"$ref":"#/$defs/text"},"status":{"enum":["IMPORTED","FAILED","NOT_RUN_TOOL_UNAVAILABLE"]},"network":{"const":"DENY"},"annotation_processors":{"$ref":"#/$defs/strings"},"classpath":{"$ref":"#/$defs/strings"},"features_and_profiles":{"$ref":"#/$defs/strings"}}},"client":{"$ref":"#/$defs/text"},"corpus_id":{"$ref":"#/$defs/id"},"navigation_capabilities":{"$ref":"#/$defs/strings"},"failure_observations":{"$ref":"#/$defs/strings"},"run_artifact":{"$ref":"#/$defs/artifactRef"},"qualification_outcome":{"enum":["QUALIFIED","FAILED","UNAVAILABLE"]}}},
    "sharedInputs":{"type":"object","additionalProperties":false,"required":["rust_toolchain","target","cargo_features","workspace_commit","client","corpus_id"],"properties":{"rust_toolchain":{"$ref":"#/$defs/text"},"target":{"$ref":"#/$defs/text"},"cargo_features":{"$ref":"#/$defs/strings"},"workspace_commit":{"$ref":"#/$defs/sha256"},"client":{"$ref":"#/$defs/text"},"corpus_id":{"$ref":"#/$defs/id"}}},
    "kickoffReview":{"type":"object","additionalProperties":false,"required":["performed","reviewed_at","reviewer_attestation","selected_release"],"properties":{"performed":{"type":"boolean"},"reviewed_at":{"type":["string","null"],"format":"date-time"},"reviewer_attestation":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},"selected_release":{"$ref":"#/$defs/text"}}},
    "rustProfile":{"type":"object","additionalProperties":false,"required":["profile_id","role","mandatory","experimental","mutually_exclusive_group","tool","shared_inputs","rust_src","isolation","evaluation_dimensions","fallback_profile_id","run_artifact","qualification_outcome"],"properties":{"profile_id":{"$ref":"#/$defs/id"},"role":{"enum":["BASELINE","EXPERIMENTAL"]},"mandatory":{"const":true},"experimental":{"type":"boolean"},"mutually_exclusive_group":{"$ref":"#/$defs/id"},"tool":{"$ref":"#/$defs/tool"},"shared_inputs":{"$ref":"#/$defs/sharedInputs"},"rust_src":{"type":"object","additionalProperties":false,"required":["required","installed","component_identity"],"properties":{"required":{"type":"boolean"},"installed":{"type":"boolean"},"component_identity":{"type":["string","null"],"pattern":"\\S"}}},"kickoff_review":{"$ref":"#/$defs/kickoffReview"},"isolation":{"$ref":"#/$defs/isolation"},"evaluation_dimensions":{"type":"array","minItems":22,"maxItems":22,"uniqueItems":true,"items":{"enum":["cold-readiness","warm-readiness","initial-index","re-index","idle-rss","peak-rss","cache-size","crash","hang","corruption","stale-result","recovery","macro","proc-macro","generated-code","build-script","target-specific","dependency","agent-elapsed","tool-calls","incorrect-edits","recovery-work"]}},"fallback_profile_id":{"type":["string","null"],"pattern":"^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},"run_artifact":{"$ref":"#/$defs/artifactRef"},"qualification_outcome":{"enum":["QUALIFIED","FAILED","UNAVAILABLE","UNSUITABLE"]}}}
  }
}
