{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaellady/verified-java-to-rust/schemas/cutover-contract-1.0.0.schema.json",
  "title": "CutoverContract 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_type","contract_id","program_snapshot_id","integration_boundary_id","platform_profile","environment_profile","replacement_boundary","state_data_compatibility","side_effect_policy","observability","slo_capacity_envelope","shadow_method","canary_method","soak_method","rollback_window","reconciliation_path","excluded_behaviors","unresolved_behaviors","readiness_ladder","obligations"],
  "properties": {
    "entity_type":{"const":"CutoverContract"},
    "contract_id":{"$ref":"#/$defs/id"},"program_snapshot_id":{"$ref":"#/$defs/id"},"integration_boundary_id":{"$ref":"#/$defs/id"},"platform_profile":{"$ref":"#/$defs/id"},"environment_profile":{"$ref":"#/$defs/id"},
    "replacement_boundary":{"$ref":"#/$defs/text"},"state_data_compatibility":{"$ref":"#/$defs/text"},"side_effect_policy":{"$ref":"#/$defs/text"},"observability":{"$ref":"#/$defs/text"},
    "slo_capacity_envelope":{"$ref":"#/$defs/sloCapacityEnvelope"},
    "shadow_method":{"$ref":"#/$defs/productionStep"},"canary_method":{"$ref":"#/$defs/productionStep"},"soak_method":{"$ref":"#/$defs/productionStep"},"rollback_window":{"$ref":"#/$defs/productionStep"},"reconciliation_path":{"$ref":"#/$defs/productionStep"},
    "excluded_behaviors":{"type":"array","items":{"$ref":"#/$defs/text"},"uniqueItems":true},
    "unresolved_behaviors":{"type":"array","maxItems":0},
    "readiness_ladder":{"const":["SOURCE_QUALIFIED","SEMANTICALLY_VERIFIED","OPERATIONALLY_VERIFIED","SHADOW_VERIFIED","CANARY_VERIFIED","CUTOVER_READY"]},
    "obligations":{"type":"array","minItems":1,"x-foundation-unique-item-property":"id","items":{"type":"object","additionalProperties":false,"required":["id","surface_id","status","evidence_ids"],"properties":{"id":{"$ref":"#/$defs/id"},"surface_id":{"$ref":"#/$defs/id"},"status":{"enum":["DECLARED","SATISFIED"]},"evidence_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}}},"allOf":[{"if":{"properties":{"status":{"const":"DECLARED"}}},"then":{"properties":{"evidence_ids":{"maxItems":0}}}},{"if":{"properties":{"status":{"const":"SATISFIED"}}},"then":{"properties":{"evidence_ids":{"minItems":1}}}}]}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "text":{"type":"string","minLength":1,"pattern":"\\S"},
    "productionStep":{"type":"object","additionalProperties":false,"required":["applicability","method","rationale","reviewer_id"],"properties":{"applicability":{"enum":["APPLICABLE","NOT_APPLICABLE"]},"method":{"type":"string"},"rationale":{"type":"string"},"reviewer_id":{"$ref":"#/$defs/id"}},"allOf":[{"if":{"properties":{"applicability":{"const":"APPLICABLE"}}},"then":{"properties":{"method":{"$ref":"#/$defs/text"},"rationale":{"$ref":"#/$defs/text"}}}},{"if":{"properties":{"applicability":{"const":"NOT_APPLICABLE"}}},"then":{"properties":{"method":{"const":""},"rationale":{"$ref":"#/$defs/text"}}}}]},
    "sloCapacityEnvelope":{"type":"object","additionalProperties":false,"required":["target_specific","predeclared","aggregation_policy","workload_classes"],"properties":{"target_specific":{"const":true},"predeclared":{"const":true},"aggregation_policy":{"const":"PER_WORKLOAD_ONLY"},"workload_classes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/performanceWorkload"}}}},
    "performanceWorkload":{"type":"object","additionalProperties":false,"required":["id","description","target_rate","rate_unit","concurrency","duration_seconds","minimum_sample_size","minimum_statistical_power","metrics"],"properties":{"id":{"$ref":"#/$defs/id"},"description":{"$ref":"#/$defs/text"},"target_rate":{"type":"number","exclusiveMinimum":0},"rate_unit":{"enum":["operations-per-second","requests-per-second","calls-per-second","bytes-per-second"]},"concurrency":{"type":"integer","minimum":1},"duration_seconds":{"type":"integer","minimum":1},"minimum_sample_size":{"type":"integer","minimum":1},"minimum_statistical_power":{"type":"number","exclusiveMinimum":0,"maximum":1},"metrics":{"type":"array","minItems":7,"maxItems":7,"items":{"$ref":"#/$defs/performanceMetric"},"allOf":[{"contains":{"properties":{"name":{"const":"memory"}}},"minContains":1,"maxContains":1},{"contains":{"properties":{"name":{"const":"cpu"}}},"minContains":1,"maxContains":1},{"contains":{"properties":{"name":{"const":"throughput"}}},"minContains":1,"maxContains":1},{"contains":{"properties":{"name":{"const":"startup"}}},"minContains":1,"maxContains":1},{"contains":{"properties":{"name":{"const":"latency"}}},"minContains":1,"maxContains":1},{"contains":{"properties":{"name":{"const":"allocation"}}},"minContains":1,"maxContains":1},{"contains":{"properties":{"name":{"const":"resource"}}},"minContains":1,"maxContains":1}]}}},
    "performanceMetric":{"type":"object","additionalProperties":false,"required":["name","comparator","threshold","unit"],"properties":{"name":{"enum":["memory","cpu","throughput","startup","latency","allocation","resource"]},"comparator":{"enum":["MAXIMUM_RUST_TO_JAVA_RATIO","MINIMUM_RUST_TO_JAVA_RATIO"]},"threshold":{"type":"number","exclusiveMinimum":0},"unit":{"const":"rust-to-java-ratio"},"measurement":{"$ref":"#/$defs/performanceMeasurement"}},"allOf":[{"if":{"properties":{"name":{"const":"memory"}}},"then":{"properties":{"comparator":{"const":"MAXIMUM_RUST_TO_JAVA_RATIO"},"threshold":{"exclusiveMinimum":0,"exclusiveMaximum":1}}}},{"if":{"properties":{"name":{"enum":["cpu","startup","latency","allocation","resource"]}}},"then":{"properties":{"comparator":{"const":"MAXIMUM_RUST_TO_JAVA_RATIO"},"threshold":{"exclusiveMinimum":0,"maximum":1}}}},{"if":{"properties":{"name":{"const":"throughput"}}},"then":{"properties":{"comparator":{"const":"MINIMUM_RUST_TO_JAVA_RATIO"},"threshold":{"minimum":1}}}}]},
    "performanceMeasurement":{"type":"object","additionalProperties":false,"required":["outcome","observed_rust_to_java_ratio","sample_size","achieved_power","evidence_id","independent_confirmation_evidence_id"],"properties":{"outcome":{"enum":["PASS","FAIL","INCONCLUSIVE"]},"observed_rust_to_java_ratio":{"type":"number","exclusiveMinimum":0},"sample_size":{"type":"integer","minimum":1},"achieved_power":{"type":"number","minimum":0,"maximum":1},"evidence_id":{"$ref":"#/$defs/id"},"independent_confirmation_evidence_id":{"$ref":"#/$defs/id"}}}
  }
}
