{
  "schema_version": "1.0.0",
  "story": "US-021",
  "note": "Polarity fixtures for cmd/fuzzpinctl. Every manifest here is SYNTHETIC VALIDATOR INPUT, never a claim artifact, and every case runs through the REAL checker with an exact expected exit code, state, and set of typed BLOCK codes. The suite's purpose is RED: a check that stays green when it is deleted is not evidence. Exactly one case is green, so a checker that blocked unconditionally would fail the suite. Modelled on assurance/replay/fixtures/us006-cases.json.",
  "cases": [
    {
      "id": "good-all-pinned",
      "manifest_path": "assurance/fuzz/fixtures/good-all-pinned.json",
      "rationale": "Every AC2 family mapped, every pin re-derivable, engine available. The suite's only green case: without it every red case below could be produced by a checker that blocks unconditionally.",
      "expected": {
        "exit_code": 0,
        "state": "OK",
        "findings": []
      }
    },
    {
      "id": "engine-unavailable-target-still-pinned",
      "manifest_path": "assurance/fuzz/fixtures/engine-unavailable-target-still-pinned.json",
      "rationale": "The engine probe cannot run and the targets still claim campaigns on it. Both the unavailability and the claim block.",
      "expected": {
        "exit_code": 1,
        "state": "BLOCKED",
        "findings": [
          "FUZZ_ENGINE_UNAVAILABLE",
          "UNAVAILABLE_REPRESENTED_AS_SKIP"
        ]
      }
    },
    {
      "id": "engine-unavailable-honestly-blocked",
      "manifest_path": "assurance/fuzz/fixtures/engine-unavailable-honestly-blocked.json",
      "rationale": "Unavailability recorded honestly as BLOCKED_UNAVAILABLE still BLOCKS. This is the load-bearing case: AC3 says unavailable tooling blocks, so an honest record of missing tooling is a block, never a pass and never a skip.",
      "expected": {
        "exit_code": 1,
        "state": "BLOCKED",
        "findings": [
          "FUZZ_ENGINE_UNAVAILABLE"
        ]
      }
    },
    {
      "id": "unavailable-as-success",
      "manifest_path": "assurance/fuzz/fixtures/unavailable-as-success.json",
      "rationale": "us006-unavailable-as-success one story over: claiming the AC met while the engine is missing is its own finding.",
      "expected": {
        "exit_code": 1,
        "state": "BLOCKED",
        "findings": [
          "FUZZ_ENGINE_UNAVAILABLE",
          "UNAVAILABLE_REPRESENTED_AS_SUCCESS"
        ]
      }
    },
    {
      "id": "blocked-unavailable-while-engine-present",
      "manifest_path": "assurance/fuzz/fixtures/blocked-unavailable-while-engine-present.json",
      "rationale": "The inverse evasion: parking a target as BLOCKED_UNAVAILABLE when the engine is installed hides a target nobody ran behind a missing-tool excuse.",
      "expected": {
        "exit_code": 1,
        "state": "BLOCKED",
        "findings": [
          "UNAVAILABLE_REPRESENTED_AS_SKIP"
        ]
      }
    },
    {
      "id": "status-skipped-is-not-a-status",
      "manifest_path": "assurance/fuzz/fixtures/status-skipped-is-not-a-status.json",
      "rationale": "There is no skip disposition in this tool. A target recorded SKIPPED is a schema violation, not a quiet pass.",
      "expected": {
        "exit_code": 1,
        "state": "BLOCKED",
        "findings": [
          "FUZZ_MANIFEST_SCHEMA_INVALID"
        ]
      }
    },
    {
      "id": "target-absent",
      "manifest_path": "assurance/fuzz/fixtures/target-absent.json",
