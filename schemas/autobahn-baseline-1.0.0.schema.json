{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaellady/verified-java-websocket-port/schemas/autobahn-baseline-1.0.0.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "evidence_kind", "accepted_root_digest", "status", "assurance", "independent_review_claimed", "image", "selected_families", "excluded_families", "registry", "client", "server", "risk_disposition", "rerun_disposition", "blocker", "production", "publication"],
  "properties": {
    "$schema": {"const": "../../schemas/autobahn-baseline-1.0.0.schema.json"},
    "schema_version": {"const": "1.0.0"}, "evidence_kind": {"const": "autobahn-baseline"},
    "accepted_root_digest": {"const": "sha256:5713245496362ece061c769bc4ee8eb909bfcc6d7d319bc3fc9b750f6e0a4ad8"}, "status": {"enum": ["PASS", "BLOCKED"]},
    "assurance": {"const": "OWNER_ATTESTED_NOT_INDEPENDENT"}, "independent_review_claimed": {"const": false},
    "image": {"type": "object", "additionalProperties": false, "required": ["manifest_digest", "manifest_bytes", "config_digest", "platform", "layers", "pull_policy", "identity_verified"], "properties": {"manifest_digest": {"const": "sha256:519915fb568b04c9383f70a1c405ae3ff44ab9e35835b085239c258b6fac3074"}, "manifest_bytes": {"const": 3477}, "config_digest": {"const": "sha256:b0475418d42ae284876bd695f0282fbe6684e00f745d787b095d60e55727a06f"}, "platform": {"const": "linux/amd64"}, "layers": {"const": 15}, "pull_policy": {"const": "never"}, "identity_verified": {"const": true}}},
    "selected_families": {"const": ["1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "10.*"]},
    "excluded_families": {"const": ["9.*", "12.*", "13.*"]},
    "registry": {"type": "object", "additionalProperties": false, "required": ["digest", "static_expansion_complete"], "properties": {"digest": {"const": "sha256:12ce097739b14751daefa1fd1ee4125ca1b95584759100563c00cf796eac7cb4"}, "static_expansion_complete": {"const": true}}},
    "client": {"$ref": "#/$defs/run"}, "server": {"$ref": "#/$defs/run"},
    "risk_disposition": {"type": "object", "additionalProperties": false, "required": ["classification", "approved_critical_findings", "approved_high_findings"], "properties": {"classification": {"const": "QUARANTINED_LABORATORY_QUALIFICATION_ONLY"}, "approved_critical_findings": {"const": 12}, "approved_high_findings": {"const": 147}}},
    "rerun_disposition": {"type": "object", "additionalProperties": false, "required": ["authorized_remediation_attempts_per_mode", "consumed_remediation_attempts_per_mode", "original_receipt_retained", "further_reruns_authorized", "disposition"], "properties": {"authorized_remediation_attempts_per_mode": {"const": 1}, "consumed_remediation_attempts_per_mode": {"const": 1}, "original_receipt_retained": {"const": true}, "further_reruns_authorized": {"const": false}, "disposition": {"const": "NO_FURTHER_RERUNS_AUTHORIZED"}}},
    "blocker": {"anyOf": [{"$ref": "#/$defs/finding"}, {"type": "null"}]},
    "production": {"const": false}, "publication": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "PASS"}}}, "then": {"properties": {"registry": {"properties": {"static_expansion_complete": {"const": true}}}, "client": {"required": ["results"], "properties": {"executed": {"const": true}, "selected_count": {"type": "integer", "minimum": 1}, "result_count": {"type": "integer", "minimum": 1}}}, "server": {"required": ["results"], "properties": {"executed": {"const": true}, "selected_count": {"type": "integer", "minimum": 1}, "result_count": {"type": "integer", "minimum": 1}}}, "blocker": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "BLOCKED"}}}, "then": {"properties": {"blocker": {"$ref": "#/$defs/finding"}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "count": {"type": ["integer", "null"], "minimum": 0},
    "run": {"type": "object", "additionalProperties": false, "required": ["attempted", "attempt_count", "completed", "executed", "first_case_id", "selected_count", "completed_count", "result_count", "attempt_state_digest", "attempt_receipt_digest", "attempt_receipt_bytes", "configuration_digest", "configuration_bytes", "blocker_digest", "blocker_bytes", "attempts"], "properties": {"attempted": {"const": true}, "attempt_count": {"const": 2}, "completed": {"type": "boolean"}, "executed": {"type": "boolean"}, "first_case_id": {"const": "1.1.1"}, "selected_count": {"const": 247}, "completed_count": {"type": "integer", "minimum": 0, "maximum": 247}, "result_count": {"type": "integer", "minimum": 0, "maximum": 247}, "attempt_state_digest": {"$ref": "#/$defs/digest"}, "attempt_receipt_digest": {"$ref": "#/$defs/digest"}, "attempt_receipt_bytes": {"type": "integer", "minimum": 1}, "configuration_digest": {"$ref": "#/$defs/digest"}, "configuration_bytes": {"type": "integer", "minimum": 1}, "blocker_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "blocker_bytes": {"type": ["integer", "null"], "minimum": 1}, "attempts": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"allOf": [{"$ref": "#/$defs/attempt"}, {"properties": {"sequence": {"const": 1}, "classification": {"const": "ORIGINAL_AUTHORITATIVE"}}}]}, {"allOf": [{"$ref": "#/$defs/attempt"}, {"properties": {"sequence": {"const": 2}, "classification": {"const": "OWNER_AUTHORIZED_REMEDIATION"}}}]}]}, "results": {"type": "array", "minItems": 247, "maxItems": 247, "items": {"$ref": "#/$defs/result"}}}, "oneOf": [{"properties": {"completed": {"const": false}, "executed": {"const": false}, "completed_count": {"const": 0}, "result_count": {"const": 0}, "blocker_digest": {"$ref": "#/$defs/digest"}, "blocker_bytes": {"type": "integer", "minimum": 1}}, "not": {"required": ["results"]}}, {"required": ["results"], "properties": {"completed": {"const": true}, "executed": {"const": true}, "completed_count": {"const": 247}, "result_count": {"const": 247}, "blocker_digest": {"type": "null"}, "blocker_bytes": {"type": "null"}}}]},
    "attempt": {"type": "object", "additionalProperties": false, "required": ["sequence", "classification", "plan_digest", "receipt_digest", "receipt_bytes", "completed", "executed", "completed_count", "result_count", "blocker"], "properties": {"sequence": {"type": "integer", "minimum": 1, "maximum": 2}, "classification": {"enum": ["ORIGINAL_AUTHORITATIVE", "OWNER_AUTHORIZED_REMEDIATION"]}, "plan_digest": {"$ref": "#/$defs/digest"}, "receipt_digest": {"$ref": "#/$defs/digest"}, "receipt_bytes": {"type": "integer", "minimum": 1}, "completed": {"type": "boolean"}, "executed": {"type": "boolean"}, "completed_count": {"type": "integer", "minimum": 0, "maximum": 247}, "result_count": {"type": "integer", "minimum": 0, "maximum": 247}, "blocker": {"anyOf": [{"$ref": "#/$defs/finding"}, {"type": "null"}]}}, "oneOf": [{"properties": {"completed": {"const": false}, "executed": {"const": false}, "completed_count": {"const": 0}, "result_count": {"const": 0}, "blocker": {"$ref": "#/$defs/finding"}}}, {"properties": {"completed": {"const": true}, "executed": {"const": true}, "completed_count": {"const": 247}, "result_count": {"const": 247}, "blocker": {"type": "null"}}}]},
    "result": {"type": "object", "additionalProperties": false, "required": ["case_id", "status", "result_digest", "observation_digest", "binding_digest"], "properties": {"case_id": {"type": "string", "pattern": "^([1-7]|10)\\.[0-9]+(?:\\.[0-9]+)*$"}, "status": {"enum": ["OK", "FAILED", "NON-STRICT", "INFORMATIONAL", "UNIMPLEMENTED"]}, "result_digest": {"$ref": "#/$defs/digest"}, "observation_digest": {"$ref": "#/$defs/digest"}, "binding_digest": {"$ref": "#/$defs/digest"}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["code", "detail"], "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}, "detail": {"type": "string", "minLength": 1, "maxLength": 2048}}}
  }
}
