{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaellady/verified-java-websocket-port/schemas/autobahn-baseline-1.0.0.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "evidence_kind", "accepted_root_digest", "status", "image", "selected_families", "excluded_families", "registry", "client", "server", "risk_disposition", "blocker", "production", "publication"],
  "properties": {
    "$schema": {"const": "../../schemas/autobahn-baseline-1.0.0.schema.json"},
    "schema_version": {"const": "1.0.0"}, "evidence_kind": {"const": "autobahn-baseline"},
    "accepted_root_digest": {"$ref": "#/$defs/digest"}, "status": {"enum": ["PASS", "BLOCKED"]},
    "image": {"type": "object", "additionalProperties": false, "required": ["manifest_digest", "manifest_bytes", "config_digest", "platform", "layers", "pull_policy", "identity_verified"], "properties": {"manifest_digest": {"const": "sha256:519915fb568b04c9383f70a1c405ae3ff44ab9e35835b085239c258b6fac3074"}, "manifest_bytes": {"const": 3477}, "config_digest": {"const": "sha256:b0475418d42ae284876bd695f0282fbe6684e00f745d787b095d60e55727a06f"}, "platform": {"const": "linux/amd64"}, "layers": {"const": 15}, "pull_policy": {"const": "never"}, "identity_verified": {"const": true}}},
    "selected_families": {"const": ["1.*", "2.*", "3.*", "4.*", "5.*", "6.*", "7.*", "10.*"]},
    "excluded_families": {"const": ["9.*", "12.*", "13.*"]},
    "registry": {"type": "object", "additionalProperties": false, "required": ["digest", "static_expansion_complete"], "properties": {"digest": {"const": "sha256:12ce097739b14751daefa1fd1ee4125ca1b95584759100563c00cf796eac7cb4"}, "static_expansion_complete": {"type": "boolean"}}},
    "client": {"$ref": "#/$defs/run"}, "server": {"$ref": "#/$defs/run"},
    "risk_disposition": {"type": "object", "additionalProperties": false, "required": ["classification", "approved_critical_findings", "approved_high_findings"], "properties": {"classification": {"const": "QUARANTINED_LABORATORY_QUALIFICATION_ONLY"}, "approved_critical_findings": {"const": 12}, "approved_high_findings": {"const": 147}}},
    "blocker": {"anyOf": [{"$ref": "#/$defs/finding"}, {"type": "null"}]},
    "production": {"const": false}, "publication": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "PASS"}}}, "then": {"properties": {"registry": {"properties": {"static_expansion_complete": {"const": true}}}, "client": {"required": ["results"], "properties": {"executed": {"const": true}, "selected_count": {"type": "integer", "minimum": 1}, "result_count": {"type": "integer", "minimum": 1}}}, "server": {"required": ["results"], "properties": {"executed": {"const": true}, "selected_count": {"type": "integer", "minimum": 1}, "result_count": {"type": "integer", "minimum": 1}}}, "blocker": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "BLOCKED"}}}, "then": {"properties": {"blocker": {"$ref": "#/$defs/finding"}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "count": {"type": ["integer", "null"], "minimum": 0},
    "run": {"type": "object", "additionalProperties": false, "required": ["executed", "selected_count", "result_count"], "properties": {"executed": {"type": "boolean"}, "selected_count": {"$ref": "#/$defs/count"}, "result_count": {"$ref": "#/$defs/count"}, "results": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/result"}}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["case_id", "status", "result_digest", "observation_digest", "binding_digest"], "properties": {"case_id": {"type": "string", "pattern": "^([1-7]|10)\\.[0-9]+(?:\\.[0-9]+)*$"}, "status": {"enum": ["OK", "FAILED", "NON-STRICT", "INFORMATIONAL", "UNIMPLEMENTED"]}, "result_digest": {"$ref": "#/$defs/digest"}, "observation_digest": {"$ref": "#/$defs/digest"}, "binding_digest": {"$ref": "#/$defs/digest"}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["code", "detail"], "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}, "detail": {"type": "string", "minLength": 1, "maxLength": 2048}}}
  }
}
