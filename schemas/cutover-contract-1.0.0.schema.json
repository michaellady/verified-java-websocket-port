{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaellady/verified-java-websocket-port/schemas/cutover-contract-1.0.0.schema.json",
  "title": "US-003 CutoverContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "entity_type",
    "contract_id",
    "replacement_boundary",
    "preserved_boundary",
    "excluded_behaviors",
    "unresolved_behaviors",
    "readiness_ladder",
    "obligations",
    "assurance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "entity_type": {
      "const": "CutoverContract"
    },
    "contract_id": {
      "$ref": "#/$defs/id"
    },
    "replacement_boundary": {
      "$ref": "#/$defs/text"
    },
    "preserved_boundary": {
      "$ref": "#/$defs/preservedBoundary"
    },
    "excluded_behaviors": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exclusionRecord"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "code": {
                "const": "EXCLUDED_TLS_WSS"
              }
            },
            "required": [
              "code"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "EXCLUDED_PROXY_SUPPORT"
              }
            },
            "required": [
              "code"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "EXCLUDED_RECONNECT"
              }
            },
            "required": [
              "code"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "EXCLUDED_ANDROID"
              }
            },
            "required": [
              "code"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "EXCLUDED_RFC_7692_PERMESSAGE_DEFLATE"
              }
            },
            "required": [
              "code"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "EXCLUDED_JAVA_API_PARITY"
              }
            },
            "required": [
              "code"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "EXCLUDED_JAVA_NIO_TOPOLOGY"
              }
            },
            "required": [
              "code"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "EXCLUDED_EXTENSION_SUBPROTOCOL_PARITY"
              }
            },
            "required": [
              "code"
            ]
          },
          "minContains": 1
        }
      ]
    },
    "unresolved_behaviors": {
      "type": "array",
      "maxItems": 0
    },
    "readiness_ladder": {
      "const": [
        "SOURCE_QUALIFIED",
        "SEMANTICALLY_VERIFIED",
        "OPERATIONALLY_VERIFIED",
        "SHADOW_VERIFIED",
        "CANARY_VERIFIED",
        "CUTOVER_READY"
      ]
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "surface_id",
          "child_story_id",
          "status",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "surface_id": {
            "$ref": "#/$defs/id"
          },
          "child_story_id": {
            "type": "string",
            "pattern": "^US-0(09|1[0-8])$"
          },
          "status": {
            "enum": [
              "DECLARED",
              "SATISFIED"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "DECLARED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "SATISFIED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "assurance": {
      "$ref": "#/$defs/assurance"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assurance",
        "independent_review_claimed",
        "production",
        "signing",
        "publication"
      ],
      "properties": {
        "assurance": {
          "const": "OWNER_ATTESTED_NOT_INDEPENDENT"
        },
        "independent_review_claimed": {
          "const": false
        },
        "production": {
          "const": false
        },
        "signing": {
          "const": false
        },
        "publication": {
          "const": false
        }
      }
    },
    "preservedBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "normative_artifact_id",
        "normative_artifact_sha256",
        "normalized_command_event_behavior",
        "wire_octet_equivalence_required",
        "statement"
      ],
      "properties": {
        "standard": {
          "const": "RFC 6455"
        },
        "normative_artifact_id": {
          "const": "rfc6455-text"
        },
        "normative_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalized_command_event_behavior": {
          "const": true
        },
        "wire_octet_equivalence_required": {
          "const": true
        },
        "statement": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "exclusionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason"
      ],
      "properties": {
        "code": {
          "enum": [
            "EXCLUDED_TLS_WSS",
            "EXCLUDED_PROXY_SUPPORT",
            "EXCLUDED_RECONNECT",
            "EXCLUDED_ANDROID",
            "EXCLUDED_RFC_7692_PERMESSAGE_DEFLATE",
            "EXCLUDED_JAVA_API_PARITY",
            "EXCLUDED_JAVA_NIO_TOPOLOGY",
            "EXCLUDED_EXTENSION_SUBPROTOCOL_PARITY"
          ]
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
