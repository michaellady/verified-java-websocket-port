{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sbx-public-projection-1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "classification", "project", "story", "attempt_id",
    "target_commit", "target_tree", "digests", "resource_envelope",
    "descriptor_summaries", "benign_artifact", "cleanup", "classifier",
    "assurance", "independent_review_claimed", "autobahn_reruns"
  ],
  "properties": {
    "schema": {"const": "1.0.0"},
    "classification": {"const": "PUBLIC_DERIVED"},
    "project": {"const": "verified-java-websocket-port"},
    "story": {"const": "US-007"},
    "attempt_id": {
      "type": "string",
      "pattern": "^us007-sbx-output-live-[0-9]{4}$",
      "not": {"const": "us007-sbx-output-live-0012"}
    },
    "target_commit": {"$ref": "#/$defs/gitObject"},
    "target_tree": {"$ref": "#/$defs/gitObject"},
    "digests": {"$ref": "#/$defs/digests"},
    "resource_envelope": {"$ref": "#/$defs/resources"},
    "descriptor_summaries": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "prefixItems": [
        {"$ref": "#/$defs/cacheWriteDenied"},
        {"$ref": "#/$defs/cleanExit"},
        {"$ref": "#/$defs/cpuBound"},
        {"$ref": "#/$defs/envSentinelAbsent"},
        {"$ref": "#/$defs/fdBound"},
        {"$ref": "#/$defs/memoryBound"},
        {"$ref": "#/$defs/networkSocketDenied"},
        {"$ref": "#/$defs/outputBound"},
        {"$ref": "#/$defs/pidBound"},
        {"$ref": "#/$defs/protectedSentinelDenied"},
        {"$ref": "#/$defs/sessionEscapeCleanup"},
        {"$ref": "#/$defs/sourceWriteDenied"},
        {"$ref": "#/$defs/wallBound"},
        {"$ref": "#/$defs/workspaceBound"},
        {"$ref": "#/$defs/benignOperation"}
      ]
    },
    "benign_artifact": {"$ref": "#/$defs/artifact"},
    "cleanup": {"$ref": "#/$defs/cleanup"},
    "classifier": {"$ref": "#/$defs/classifier"},
    "assurance": {"const": "OWNER_ATTESTED_NOT_INDEPENDENT"},
    "independent_review_claimed": {"const": false},
    "autobahn_reruns": {"const": 0}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed_plan_digest", "profile_digest", "policy_digest",
        "runtime_digest", "template_digest", "supervisor_digest",
        "authorization_closure_digest"
      ],
      "properties": {
        "fixed_plan_digest": {"const": "sha256:f5d76d8e7c85cc2a5612f21d4ca3657e919cd927e0764ddf46fe6459ae8053ba"},
        "profile_digest": {"const": "sha256:02c66593f3499b19db934428614d115880a216962292f0af68f2122c3726b750"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "runtime_digest": {"$ref": "#/$defs/digest"},
        "template_digest": {"const": "sha256:113547b4bf0f85f83b04a948b45d8a9a962fa0a2dc38eed5180588dbdac611fc"},
        "supervisor_digest": {"$ref": "#/$defs/digest"},
        "authorization_closure_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds", "cpu_seconds", "memory_bytes", "pids", "open_files",
        "output_bytes", "workspace_bytes", "cache_bytes", "disk_bytes", "inodes"
      ],
      "properties": {
        "wall_seconds": {"const": 60},
        "cpu_seconds": {"const": 60},
        "memory_bytes": {"const": 1073741824},
        "pids": {"const": 64},
        "open_files": {"const": 256},
        "output_bytes": {"const": 8388608},
        "workspace_bytes": {"const": 67108864},
        "cache_bytes": {"const": 67108864},
        "disk_bytes": {"const": 67108864},
        "inodes": {"const": 16384}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptor_id", "accepted", "raw_receipt_digest"],
      "properties": {
        "descriptor_id": {"type": "string"},
        "accepted": {"const": true},
        "raw_receipt_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "cacheWriteDenied": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "CACHE_WRITE_DENIED"}}},
    "cleanExit": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "CLEAN_EXIT"}}},
    "cpuBound": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "CPU_BOUND"}}},
    "envSentinelAbsent": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "ENV_SENTINEL_ABSENT"}}},
    "fdBound": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "FD_BOUND"}}},
    "memoryBound": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "MEMORY_BOUND"}}},
    "networkSocketDenied": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "NETWORK_SOCKET_DENIED"}}},
    "outputBound": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "OUTPUT_BOUND"}}},
    "pidBound": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "PID_BOUND"}}},
    "protectedSentinelDenied": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "PROTECTED_SENTINEL_DENIED"}}},
    "sessionEscapeCleanup": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "SESSION_ESCAPE_CLEANUP"}}},
    "sourceWriteDenied": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "SOURCE_WRITE_DENIED"}}},
    "wallBound": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "WALL_BOUND"}}},
    "workspaceBound": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "WORKSPACE_BOUND"}}},
    "benignOperation": {"$ref": "#/$defs/summary", "properties": {"descriptor_id": {"const": "BENIGN_OPERATION"}}},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "bytes"],
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 4194304}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remove_digest", "absence_digest", "sandbox_absent"],
      "properties": {
        "remove_digest": {"$ref": "#/$defs/digest"},
        "absence_digest": {"$ref": "#/$defs/digest"},
        "sandbox_absent": {"const": true}
      }
    },
    "classifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_digest", "input_digest", "action_digest", "output_digest"],
      "properties": {
        "rule_digest": {"const": "sha256:c69d5471dc6803291a59575dc513ac30e0774c2d4e7e43edaa604703b6f2f432"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "action_digest": {"$ref": "#/$defs/digest"},
        "output_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
