{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus-handshake-case-1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "family", "seed_index", "direction", "raw_base64", "config", "context", "expected"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^us005\\.hs\\.[0-9]{4}$"},
    "family": {"type": "string", "minLength": 1},
    "seed_index": {"type": "integer", "minimum": 0},
    "direction": {"enum": ["client_request", "server_response"]},
    "raw_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_handshake_bytes", "max_header_count", "max_header_line_bytes"],
      "properties": {
        "max_handshake_bytes": {"type": "integer", "minimum": 1},
        "max_header_count": {"type": "integer", "minimum": 1},
        "max_header_line_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_key": {"type": "string", "pattern": "^[A-Za-z0-9+/]{22}==$"}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "basis"],
      "properties": {
        "verdict": {"enum": ["accept", "reject", "incomplete"]},
        "reject_code": {"type": "string", "pattern": "^HS_[A-Z0-9_]+$"},
        "sec_websocket_accept": {"type": "string", "pattern": "^[A-Za-z0-9+/]{27}=$"},
        "basis": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^rfc[0-9]+\\."}}
      }
    }
  }
}
