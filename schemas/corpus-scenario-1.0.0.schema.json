{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus-scenario-1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "tier", "family", "seed_index", "role", "initial_state", "limits", "steps", "expected", "expectation_basis", "expectation_status"],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^us005\\.(pub|hid|sea)\\.[0-9]{4}$"},
    "tier": {"enum": ["public", "hidden", "sealed"]},
    "family": {"type": "string", "minLength": 1},
    "seed_index": {"type": "integer", "minimum": 0},
    "role": {"enum": ["server", "client"]},
    "initial_state": {"enum": ["open", "closing", "closed"]},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_input_bytes", "max_buffered_bytes", "max_actions", "max_frames", "max_output_bytes"],
      "properties": {
        "max_input_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_buffered_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_actions": {"type": "integer", "minimum": 0, "maximum": 1024},
        "max_frames": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_output_bytes": {"type": "integer", "minimum": 512, "maximum": 4194304}
      }
    },
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "expected": {"$ref": "#/$defs/expected"},
    "expectation_basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expectation_status": {"const": "REFERENCE_MODEL_DERIVED_PENDING_ORACLE_CONFIRMATION"}
  },
  "$defs": {
    "base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "data_base64"],
          "properties": {
            "kind": {"const": "bytes"},
            "data_base64": {"$ref": "#/$defs/base64"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "action", "text"],
          "properties": {
            "kind": {"const": "action"},
            "action": {"const": "send_text"},
            "text": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "action", "data_base64"],
          "properties": {
            "kind": {"const": "action"},
            "action": {"enum": ["send_binary", "send_ping", "send_pong"]},
            "data_base64": {"$ref": "#/$defs/base64"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "action", "code", "reason"],
          "properties": {
            "kind": {"const": "action"},
            "action": {"const": "send_close"},
            "code": {"type": "integer", "minimum": 0, "maximum": 65535},
            "reason": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "action", "data_base64", "fin", "opcode"],
          "properties": {
            "kind": {"const": "action"},
            "action": {"const": "send_fragment"},
            "data_base64": {"$ref": "#/$defs/base64"},
            "fin": {"type": "boolean"},
            "opcode": {"enum": ["text", "binary"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "action"],
          "properties": {
            "kind": {"const": "action"},
            "action": {"const": "eof"}
          }
        }
      ]
    },
    "state": {"enum": ["open", "closing", "closed"]},
    "event": {
      "type": "object",
      "required": ["type", "step"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "step": {"type": "integer", "minimum": 0}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "fin", "masked", "opcode", "payload_base64", "payload_bytes", "rsv1", "rsv2", "rsv3", "step", "wire_bytes"],
      "properties": {
        "direction": {"enum": ["inbound", "outbound"]},
        "fin": {"type": "boolean"},
        "masked": {"type": "boolean"},
        "opcode": {"enum": ["continuous", "text", "binary", "closing", "ping", "pong"]},
        "payload_base64": {"$ref": "#/$defs/base64"},
        "payload_bytes": {"type": "integer", "minimum": 0},
        "rsv1": {"type": "boolean"},
        "rsv2": {"type": "boolean"},
        "rsv3": {"type": "boolean"},
        "step": {"type": "integer", "minimum": 0},
        "wire_bytes": {"type": "integer", "minimum": 2}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cause", "from", "step", "to"],
      "properties": {
        "cause": {"type": "string", "minLength": 1},
        "from": {"$ref": "#/$defs/state"},
        "step": {"type": "integer", "minimum": 0},
        "to": {"$ref": "#/$defs/state"}
      }
    },
    "close": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "handshake_complete", "origin", "reason", "remote"],
      "properties": {
        "code": {"type": "integer", "minimum": 0, "maximum": 65535},
        "handshake_complete": {"type": "boolean"},
        "origin": {"enum": ["remote", "local", "transport"]},
        "reason": {"type": "string"},
        "remote": {"type": "boolean"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "buffered_bytes", "consumed_bytes", "frames", "input_bytes", "message_buffered_bytes", "wire_buffered_bytes"],
      "properties": {
        "actions": {"type": "integer", "minimum": 0},
        "buffered_bytes": {"type": "integer", "minimum": 0},
        "consumed_bytes": {"type": "integer", "minimum": 0},
        "frames": {"type": "integer", "minimum": 0},
        "input_bytes": {"type": "integer", "minimum": 0},
        "message_buffered_bytes": {"type": "integer", "minimum": 0},
        "wire_buffered_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "final_state", "events", "frames", "transitions", "close", "counts"],
          "properties": {
            "outcome": {"const": "ok"},
            "final_state": {"$ref": "#/$defs/state"},
            "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
            "frames": {"type": "array", "items": {"$ref": "#/$defs/frame"}},
            "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
            "close": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/close"}]},
            "counts": {"$ref": "#/$defs/counts"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "final_state", "error"],
          "properties": {
            "outcome": {"const": "error"},
            "final_state": {"$ref": "#/$defs/state"},
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code"],
              "properties": {
                "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
                "close_code": {"type": "integer", "minimum": 1000, "maximum": 4999}
              }
            }
          }
        }
      ]
    }
  }
}
