  "properties":{
    "$schema":{"const":"../schemas/cutover-evidence-1.0.0.schema.json"},"schema":{"const":"vjwp-cutover-evidence/1.0.0"},"story_id":{"const":"US-026"},"subject":{"$ref":"#/$defs/subject"},"artifacts":{"type":"array","minItems":5,"maxItems":5,"prefixItems":[{"$ref":"#/$defs/contractArtifact"},{"$ref":"#/$defs/shadowArtifact"},{"$ref":"#/$defs/canaryArtifact"},{"$ref":"#/$defs/rollbackArtifact"},{"$ref":"#/$defs/soakArtifact"}]},"summary":{"$ref":"#/$defs/summary"},"mechanics_status":{"const":"PASS_OWNER_RELAXED_REHEARSAL_MECHANICS"},"cutover_acceptance":{"const":"CUTOVER_BLOCKED"},"cutover_ready_reached":{"const":false},"assurance":{"const":"OWNER_ATTESTED_NOT_INDEPENDENT"},"independent_review_claimed":{"const":false},"production":{"const":false},"signing":{"const":false},"publication":{"const":false},"blockers":{"const":["PRODUCTION_SHAPED_ENVIRONMENT_NOT_BOUND","LIVE_SHADOW_NOT_EXECUTED","LIVE_CANARY_NOT_EXECUTED","REAL_SIDE_EFFECT_ISOLATION_NOT_EXECUTED","US025_MEASURED_CAPACITY_NOT_ACCEPTED","REAL_RESOURCE_MONITORING_NOT_EXECUTED","WALL_CLOCK_SOAK_NOT_EXECUTED","REAL_JAVA_FALLBACK_BINARY_NOT_REBUILT_OR_DRILLED","REAL_ROLLBACK_BOUND_NOT_MEASURED","INDEPENDENT_ATTESTATION_NOT_EXECUTED","PRODUCTION_DEPLOYMENT_NOT_AUTHORIZED","JAVA_REMOVAL_NOT_AUTHORIZED"]},"nonclaims":{"const":["no production-shaped rehearsal","no live traffic or effects","no measured capacity or resources","no elapsed soak or rollback bound","no executable Java fallback drill","no CUTOVER_READY or deployment readiness","no production mutation, publication, signing, or Java removal"]},"provenance":{"$ref":"#/$defs/provenance"}
