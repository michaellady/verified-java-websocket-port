{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaellady/verified-java-websocket-port/schemas/observed-disagreements-1.0.0.schema.json",
  "title": "Observed Java-vs-RFC disagreement set",
  "description": "The committed set of observed disagreements that makes the behavior-delta ledger's unledgered_disagreements field a real measurement. The ledger counts how many of these have no record; the readiness gate refuses on any nonzero count. The 'observed' array is exactly the shape cmd/labctl consumes through its --observed flag.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "evidence_kind",
    "statement",
    "observed",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/observed-disagreements-1.0.0.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "evidence_kind": {
      "const": "observed-disagreement-set"
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "observed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/provenance"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_ref",
        "rfc_refs",
        "rfc_expectation_digest",
        "rfc_value_digest",
        "java_ref",
        "java_observation_digest",
        "java_value_digest",
        "autobahn_refs",
        "autobahn_result_digest",
        "autobahn_value_digest"
      ],
      "properties": {
        "subject_ref": {
          "type": "string",
          "pattern": "^semantic:[a-z0-9][a-z0-9._-]{0,127}:provisional-v[0-9]+$"
        },
        "rfc_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^rfc6455#section-[0-9]+(?:\\.[0-9]+)*$"
          }
        },
        "rfc_expectation_digest": {
          "$ref": "#/$defs/digest"
        },
        "rfc_value_digest": {
          "$ref": "#/$defs/digest"
        },
        "java_ref": {
          "type": "string",
          "pattern": "^java-v1\\.6\\.0:[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "java_observation_digest": {
          "$ref": "#/$defs/digest"
        },
        "java_value_digest": {
          "$ref": "#/$defs/digest"
        },
        "autobahn_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^autobahn-v25\\.10\\.1:([1-7]|9|10|12|13)\\.[0-9]+(?:\\.[0-9]+)*$"
          }
        },
        "autobahn_result_digest": {
          "$ref": "#/$defs/digest"
        },
        "autobahn_value_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_ref",
        "source_kind",
        "evidence"
      ],
      "properties": {
        "subject_ref": {
          "type": "string",
          "pattern": "^semantic:[a-z0-9][a-z0-9._-]{0,127}:provisional-v[0-9]+$"
        },
        "source_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  }
}
