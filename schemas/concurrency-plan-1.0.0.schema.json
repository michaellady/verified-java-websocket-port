{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-java-websocket-port.invalid/schemas/concurrency-plan-1.0.0.schema.json",
  "title": "ConcurrencyPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "entity_type",
    "plan_id",
    "story_id",
    "implementation_state",
    "owner_symbol",
    "actions",
    "bounds",
    "fairness",
    "properties",
    "seeded_defects",
    "required_artifacts",
    "claim_scope",
    "native_thread_evidence",
    "assurance",
    "independent_review_claimed",
    "production",
    "publication"
  ],
  "properties": {
    "$schema": {"const": "../../schemas/concurrency-plan-1.0.0.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "entity_type": {"const": "ConcurrencyPlan"},
    "plan_id": {"const": "concurrency-plan.us006.v1"},
    "story_id": {"const": "US-017"},
    "implementation_state": {"const": "FUTURE_PRODUCTION_REFINEMENT"},
    "owner_symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "state"],
      "properties": {
        "symbol": {"const": "websocket_driver::owner::ConnectionOwner::step"},
        "state": {"const": "UNRESOLVED_FUTURE_PRODUCTION_SYMBOL"}
      }
    },
    "actions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/action"}
    },
    "bounds": {"$ref": "#/$defs/bounds"},
    "fairness": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/property"}
    },
    "seeded_defects": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/defect"}
    },
    "required_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_scope": {"const": "SYSTEMATIC_CONCURRENCY_TESTING"},
    "native_thread_evidence": {"$ref": "#/$defs/nativeThreadEvidence"},
    "assurance": {"const": "OWNER_ATTESTED_NOT_INDEPENDENT"},
    "independent_review_claimed": {"const": false},
    "production": {"const": false},
    "publication": {"const": false}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "actor",
        "preconditions",
        "effects",
        "observable_outcomes",
        "maximum_occurrences_per_schedule"
      ],
      "properties": {
        "action_id": {"$ref": "#/$defs/identifier"},
        "actor": {"type": "string", "minLength": 1},
        "preconditions": {"$ref": "#/$defs/stringSet"},
        "effects": {"$ref": "#/$defs/stringSet"},
        "observable_outcomes": {"$ref": "#/$defs/stringSet"},
        "maximum_occurrences_per_schedule": {"type": "integer", "minimum": 1}
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_tasks",
        "owner_tasks",
        "inbound_tasks",
        "flush_tasks",
        "callback_tasks",
        "shutdown_tasks",
        "max_tasks",
        "command_queue_capacity",
        "write_queue_capacity",
        "event_queue_capacity",
        "commands_per_producer",
        "inbound_actions",
        "flush_actions",
        "callback_actions",
        "shutdown_actions",
        "max_schedules",
        "max_preemptions",
        "max_branches"
      ],
      "properties": {
        "producer_tasks": {"type": "integer", "minimum": 1},
        "owner_tasks": {"type": "integer", "minimum": 1},
        "inbound_tasks": {"type": "integer", "minimum": 1},
        "flush_tasks": {"type": "integer", "minimum": 1},
        "callback_tasks": {"type": "integer", "minimum": 1},
        "shutdown_tasks": {"type": "integer", "minimum": 1},
        "max_tasks": {"type": "integer", "minimum": 1},
        "command_queue_capacity": {"type": "integer", "minimum": 1},
        "write_queue_capacity": {"type": "integer", "minimum": 1},
        "event_queue_capacity": {"type": "integer", "minimum": 1},
        "commands_per_producer": {"type": "integer", "minimum": 1},
        "inbound_actions": {"type": "integer", "minimum": 1},
        "flush_actions": {"type": "integer", "minimum": 1},
        "callback_actions": {"type": "integer", "minimum": 1},
        "shutdown_actions": {"type": "integer", "minimum": 1},
        "max_schedules": {"type": "integer", "minimum": 1},
        "max_preemptions": {"type": "integer", "minimum": 1},
        "max_branches": {"type": "integer", "minimum": 1}
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_id", "statement"],
      "properties": {
        "property_id": {"$ref": "#/$defs/identifier"},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defect_id", "property_id", "mutation", "expected_outcome"],
      "properties": {
        "defect_id": {"$ref": "#/$defs/identifier"},
        "property_id": {"$ref": "#/$defs/identifier"},
        "mutation": {"type": "string", "minLength": 1},
        "expected_outcome": {"const": "COUNTEREXAMPLE"}
      }
    },
    "nativeThreadEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "claim_scope", "required_fields", "limitations"],
      "properties": {
        "state": {"const": "FUTURE_REQUIRED"},
        "claim_scope": {"const": "FUTURE_PRODUCTION_REFINEMENT"},
        "required_fields": {"$ref": "#/$defs/stringSet"},
        "limitations": {"$ref": "#/$defs/stringSet"}
      }
    }
  }
}
