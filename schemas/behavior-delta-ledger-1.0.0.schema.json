{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaellady/verified-java-websocket-port/schemas/behavior-delta-ledger-1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "evidence_kind",
    "accepted_root_digest",
    "status",
    "normative_authority",
    "head",
    "records",
    "append_implementation",
    "unledgered_disagreements",
    "production",
    "publication"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/behavior-delta-ledger-1.0.0.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "evidence_kind": {
      "const": "behavior-delta-ledger"
    },
    "accepted_root_digest": {
      "$ref": "#/$defs/digest"
    },
    "status": {
      "enum": [
        "READY",
        "BLOCKED_PENDING_BASELINE"
      ]
    },
    "normative_authority": {
      "const": "rfc6455"
    },
    "head": {
      "$ref": "#/$defs/digest"
    },
    "records": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "append_implementation": {
      "const": "hash-chained-cas"
    },
    "unledgered_disagreements": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000,
      "description": "COMPUTED count of observed disagreements (evidence/java/observed-disagreements.json) that have no ledger record. Was previously const 0, which made it a gate that could not fail; the zero REQUIREMENT now lives in the readiness gate (internal/lab VerifyBaselineEvidence), which refuses readiness on any nonzero value."
    },
    "production": {
      "const": false
    },
    "publication": {
      "const": false
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sequence",
        "previous_digest",
        "delta",
        "record_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "previous_digest": {
          "$ref": "#/$defs/digest"
        },
        "delta": {
          "$ref": "#/$defs/delta"
        },
        "record_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "delta_id",
        "subject_ref",
        "rfc_refs",
        "rfc_expectation_digest",
        "rfc_value_digest",
        "java_ref",
        "java_observation_digest",
        "java_value_digest",
        "autobahn_refs",
        "autobahn_result_digest",
        "autobahn_value_digest",
        "disagreement_digest",
        "normative_authority",
        "disposition",
        "rationale"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "delta_id": {
          "type": "string",
          "pattern": "^delta-[0-9a-f]{64}$"
        },
        "subject_ref": {
          "type": "string",
          "pattern": "^semantic:[a-z0-9][a-z0-9._-]{0,127}:provisional-v[0-9]+$"
        },
        "rfc_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^rfc6455#section-[0-9]+(?:\\.[0-9]+)*$"
          }
        },
        "rfc_expectation_digest": {
          "$ref": "#/$defs/digest"
        },
        "rfc_value_digest": {
          "$ref": "#/$defs/digest"
        },
        "java_ref": {
          "type": "string",
          "pattern": "^java-v1\\.6\\.0:[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "java_observation_digest": {
          "$ref": "#/$defs/digest"
        },
        "java_value_digest": {
          "$ref": "#/$defs/digest"
        },
        "autobahn_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^autobahn-v25\\.10\\.1:([1-7]|9|10|12|13)\\.[0-9]+(?:\\.[0-9]+)*$"
          }
        },
        "autobahn_result_digest": {
          "$ref": "#/$defs/digest"
        },
        "autobahn_value_digest": {
          "$ref": "#/$defs/digest"
        },
        "disagreement_digest": {
          "$ref": "#/$defs/digest"
        },
        "normative_authority": {
          "const": "rfc6455"
        },
        "disposition": {
          "enum": [
            "unresolved",
            "rfc-governs"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
