{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-java-websocket-port/schemas/ledger-supersessions-1.0.0.schema.json",
  "title": "Behavior-delta ledger supersessions 1.0.0",
  "description": "Machine-readable supersession map for evidence/java/behavior-delta-ledger.json. The frozen behavior-delta-ledger 1.0.0 record vocabulary has no supersedes link and no authoritative-state field, and the owner ruling for the frozen prefix is SUPERSEDE, DO NOT REWRITE, so a superseded record stays byte-identical in the hash chain with disposition 'unresolved' exactly like its correction. This document states, as data rather than as prose, which records are no longer the authoritative statement of their subject. It is rendered by cmd/deltaledgerctl from canonical SUPERSEDES tokens carried inside the superseding records' own hashed rationale preimages, so it cannot become a separate story from the chain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "evidence_kind",
    "statement",
    "authority",
    "links"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../../schemas/ledger-supersessions-1.0.0.schema.json"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "evidence_kind": {
      "type": "string",
      "const": "ledger-supersessions"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "superseded_sequence",
          "superseded_delta_id",
          "superseded_subject_ref",
          "superseding_sequence",
          "superseding_delta_id",
          "superseding_subject_ref"
        ],
        "properties": {
          "superseded_sequence": {
            "type": "integer",
            "minimum": 1
          },
          "superseded_delta_id": {
            "type": "string",
            "pattern": "^delta-[0-9a-f]{64}$"
          },
          "superseded_subject_ref": {
            "type": "string",
            "pattern": "^semantic:[a-z0-9][a-z0-9._-]{0,127}:provisional-v[0-9]+$"
          },
          "superseding_sequence": {
            "type": "integer",
            "minimum": 2
          },
          "superseding_delta_id": {
            "type": "string",
            "pattern": "^delta-[0-9a-f]{64}$"
          },
          "superseding_subject_ref": {
            "type": "string",
            "pattern": "^semantic:[a-z0-9][a-z0-9._-]{0,127}:provisional-v[0-9]+$"
          }
        }
      }
    }
  }
}
