{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaellady/verified-java-websocket-port/schemas/server-handshake-evidence-1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "evidence_id", "story_id", "source", "toolchain", "tests", "corpus", "symbols", "compatibility", "delta_ledger", "evidence_dag_claim", "evidence_dag_path", "evidence_dag_sha256", "nonclaims", "assurance"],
  "properties": {
    "$schema": {"const": "../schemas/server-handshake-evidence-1.0.0.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "evidence_id": {"const": "evidence.us-011-server-handshake"},
    "story_id": {"const": "US-011"},
    "source": {"$ref": "#/$defs/object"},
    "toolchain": {"$ref": "#/$defs/object"},
    "tests": {"$ref": "#/$defs/object"},
    "corpus": {"$ref": "#/$defs/corpus"},
    "symbols": {"$ref": "#/$defs/object"},
    "compatibility": {"$ref": "#/$defs/object"},
    "delta_ledger": {"$ref": "#/$defs/object"},
    "evidence_dag_claim": {"const": "claim-us011-server-handshake"},
    "evidence_dag_path": {"const": "assurance/us011-evidence-dag.json"},
    "evidence_dag_sha256": {"$ref": "#/$defs/digest"},
    "nonclaims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assurance": {
      "type": "object", "additionalProperties": false,
      "required": ["assurance", "independent_review_claimed", "production", "publication", "signing"],
      "properties": {
        "assurance": {"const": "OWNER_ATTESTED_NOT_INDEPENDENT"},
        "independent_review_claimed": {"const": false},
        "production": {"const": false},
        "publication": {"const": false},
        "signing": {"const": false}
      }
    }
  },
  "$defs": {
    "object": {"type": "object", "minProperties": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "corpus": {
      "type": "object", "additionalProperties": false,
      "required": ["projection_path", "projection_sha256", "schema_path", "schema_sha256", "evidence_schema_path", "evidence_schema_sha256", "frozen_source_sha256", "public_additive_vectors", "fuzz_seed_count", "nonce_vector_count"],
      "properties": {
        "projection_path": {"const": "corpora/handshake/server.json"},
        "projection_sha256": {"$ref": "#/$defs/digest"},
        "schema_path": {"const": "schemas/server-handshake-corpus-1.0.0.schema.json"},
        "schema_sha256": {"$ref": "#/$defs/digest"},
        "evidence_schema_path": {"const": "schemas/server-handshake-evidence-1.0.0.schema.json"},
        "evidence_schema_sha256": {"$ref": "#/$defs/digest"},
        "frozen_source_sha256": {"$ref": "#/$defs/digest"},
        "public_additive_vectors": {"const": 26},
        "fuzz_seed_count": {"const": 17},
        "nonce_vector_count": {"const": 256}
      }
    }
  }
}
