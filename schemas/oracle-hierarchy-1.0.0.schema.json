{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-java-websocket-port.invalid/oracle-hierarchy-1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "evidence_kind", "scenario_count", "cell_count", "cells"],
  "properties": {
    "$schema": {"const": "../schemas/oracle-hierarchy-1.0.0.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "evidence_kind": {"const": "oracle-hierarchy"},
    "scenario_count": {"const": 74},
    "cell_count": {"type": "integer", "minimum": 75, "maximum": 8192},
    "cells": {
      "type": "array", "minItems": 75, "maxItems": 8192,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scenario_id", "pointer", "authority", "rank", "expected_sha256", "evidence"],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^us005\\.pub\\.[0-9]{4}$"},
          "pointer": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^/"},
          "authority": {"enum": ["rfc6455.section-5-2", "rfc6455.section-7-4", "neutral"]},
          "rank": {"enum": [1, 3]},
          "expected_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "evidence": {
            "type": "array", "minItems": 1, "maxItems": 4,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "id", "sha256"],
              "properties": {
                "kind": {"enum": ["rfc_clause", "committed_neutral_expectation"]},
                "id": {"type": "string", "minLength": 1, "maxLength": 768},
                "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
