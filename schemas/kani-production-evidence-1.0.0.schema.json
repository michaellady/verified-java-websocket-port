{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-java-websocket-port.invalid/schemas/kani-production-evidence-1.0.0.schema.json",
  "title": "KaniProductionSymbolEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "evidence_kind",
    "subject",
    "toolchain",
    "execution",
    "status",
    "claim_scope",
    "limitations",
    "assurance",
    "independent_review_claimed",
    "production",
    "signing",
    "publication"
  ],
  "properties": {
    "$schema": {"const": "../../../schemas/kani-production-evidence-1.0.0.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "evidence_kind": {"const": "KANI_PRODUCTION_SYMBOL_EVIDENCE"},
    "subject": {"$ref": "#/$defs/subject"},
    "toolchain": {"$ref": "#/$defs/toolchain"},
    "execution": {"$ref": "#/$defs/execution"},
    "status": {"const": "PASS"},
    "claim_scope": {"const": "OWNER_EXECUTED_KANI_PRODUCTION_SYMBOLS"},
    "limitations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "assurance": {"const": "OWNER_ATTESTED_NOT_INDEPENDENT"},
    "independent_review_claimed": {"const": false},
    "production": {"const": false},
    "signing": {"const": false},
    "publication": {"const": false}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "object_format", "clean_checkout", "sources"],
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "tree": {"$ref": "#/$defs/commit"},
        "object_format": {"const": "sha1"},
        "clean_checkout": {"const": true},
        "sources": {
          "type": "array",
          "oneOf": [
            {
              "minItems": 2,
              "maxItems": 2
            },
            {
              "minItems": 4,
              "maxItems": 4
            },
            {
              "minItems": 5,
              "maxItems": 5
            },
            {
              "minItems": 6,
              "maxItems": 6
            },
            {
              "minItems": 7,
              "maxItems": 7
            }
          ],
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kani_version",
        "kani_source_commit",
        "kani_source_tree",
        "cargo_kani_sha256",
        "kani_compiler_sha256",
        "cbmc_version",
        "cbmc_sha256",
        "rustc_version",
        "rustc_sha256",
        "driver_sha256"
      ],
      "properties": {
        "kani_version": {"type": "string", "minLength": 1},
        "kani_source_commit": {"$ref": "#/$defs/commit"},
        "kani_source_tree": {"$ref": "#/$defs/commit"},
        "cargo_kani_sha256": {"$ref": "#/$defs/digest"},
        "kani_compiler_sha256": {"$ref": "#/$defs/digest"},
        "cbmc_version": {"type": "string", "minLength": 1},
        "cbmc_sha256": {"$ref": "#/$defs/digest"},
        "rustc_version": {"type": "string", "minLength": 1},
        "rustc_sha256": {"$ref": "#/$defs/digest"},
        "driver_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness_id", "target_symbol", "source_path", "obligation_ids", "unwind", "symbolic_domain"],
      "properties": {
        "harness_id": {"type": "string", "minLength": 1},
        "target_symbol": {"type": "string", "minLength": 1},
        "source_path": {"$ref": "#/$defs/path"},
        "obligation_ids": {"$ref": "#/$defs/stringSet"},
        "unwind": {"type": "integer", "minimum": 1},
        "symbolic_domain": {"$ref": "#/$defs/stringSet"}
      }
    },
    "kaniResult": {
      "type": "object",
      "required": ["status", "exit_code", "failed_checks", "total_checks", "unreachable_checks", "raw_output_sha256", "normalized_log"],
      "properties": {
        "status": {"enum": ["PASS", "COUNTEREXAMPLE"]},
        "exit_code": {"type": "integer"},
        "failed_checks": {"type": "integer", "minimum": 0},
        "total_checks": {"type": "integer", "minimum": 1},
        "unreachable_checks": {"type": "integer", "minimum": 0},
        "raw_output_sha256": {"$ref": "#/$defs/digest"},
        "normalized_log": {"$ref": "#/$defs/artifact"}
      }
    },
    "harnessResult": {
      "allOf": [
        {"$ref": "#/$defs/kaniResult"},
        {
          "type": "object",
          "required": ["harness_id"],
          "properties": {"harness_id": {"type": "string", "minLength": 1}}
        }
      ],
      "unevaluatedProperties": false
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "results", "semantic_projection_sha256"],
      "properties": {
        "run_id": {"enum": ["run-1", "run-2"]},
        "results": {
          "type": "array",
          "oneOf": [
            {
              "minItems": 9,
              "maxItems": 9
            },
            {
              "minItems": 11,
              "maxItems": 11
            },
            {
              "minItems": 12,
              "maxItems": 12
            },
            {
              "minItems": 13,
              "maxItems": 13
            },
            {
              "minItems": 14,
              "maxItems": 14
            },
            {
              "minItems": 15,
              "maxItems": 15
            }
          ],
          "items": {"$ref": "#/$defs/harnessResult"}
        },
        "semantic_projection_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "mutation": {
      "allOf": [
        {"$ref": "#/$defs/kaniResult"},
        {
          "type": "object",
          "required": ["canary_id", "harness_id", "source_path", "mutation", "baseline_source_sha256", "mutated_source_sha256", "obligation_ids"],
          "properties": {
            "canary_id": {"type": "string", "minLength": 1},
            "harness_id": {"type": "string", "minLength": 1},
            "source_path": {"$ref": "#/$defs/path"},
            "mutation": {"type": "string", "minLength": 1},
            "baseline_source_sha256": {"$ref": "#/$defs/digest"},
            "mutated_source_sha256": {"$ref": "#/$defs/digest"},
            "obligation_ids": {"$ref": "#/$defs/stringSet"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goos",
        "goarch",
        "pointer_width",
        "environment",
        "harnesses",
        "repeat_count",
        "runs",
        "semantically_identical",
        "semantic_projection_sha256",
        "mutation_canaries",
        "mutation_survivors",
        "unsupported_constructs"
      ],
      "properties": {
        "goos": {"const": "darwin"},
        "goarch": {"const": "arm64"},
        "pointer_width": {"const": 64},
        "environment": {"$ref": "#/$defs/stringSet"},
        "harnesses": {
          "type": "array",
          "oneOf": [
            {
              "minItems": 9,
              "maxItems": 9
            },
            {
              "minItems": 11,
              "maxItems": 11
            },
            {
              "minItems": 12,
              "maxItems": 12
            },
            {
              "minItems": 13,
              "maxItems": 13
            },
            {
              "minItems": 14,
              "maxItems": 14
            },
            {
              "minItems": 15,
              "maxItems": 15
            }
          ],
          "items": {"$ref": "#/$defs/harness"}
        },
        "repeat_count": {"const": 2},
        "runs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/run"}
        },
        "semantically_identical": {"const": true},
        "semantic_projection_sha256": {"$ref": "#/$defs/digest"},
        "mutation_canaries": {
          "type": "array",
          "oneOf": [
            {
              "minItems": 9,
              "maxItems": 9
            },
            {
              "minItems": 11,
              "maxItems": 11
            },
            {
              "minItems": 13,
              "maxItems": 13
            },
            {
              "minItems": 14,
              "maxItems": 14
            },
            {
              "minItems": 16,
              "maxItems": 16
            },
            {
              "minItems": 17,
              "maxItems": 17
            },
            {
              "minItems": 18,
              "maxItems": 18
            }
          ],
          "items": {"$ref": "#/$defs/mutation"}
        },
        "mutation_survivors": {"const": 0},
        "unsupported_constructs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
