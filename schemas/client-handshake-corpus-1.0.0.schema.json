{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaellady/verified-java-websocket-port/schemas/client-handshake-corpus-1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "corpus_id", "frozen_source", "frozen_cases", "additive_vectors", "properties", "fuzz_seeds", "nonclaims", "assurance"],
  "properties": {
    "$schema": {"const": "../../schemas/client-handshake-corpus-1.0.0.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "corpus_id": {"const": "us010-client-handshake"},
    "frozen_source": {
      "type": "object", "additionalProperties": false,
      "required": ["corpus_id", "artifact", "sha256", "selected_case_ids"],
      "properties": {
        "corpus_id": {"const": "us005-handshake"},
        "artifact": {"const": "corpora/handshake/cases.jsonl"},
        "sha256": {"const": "sha256:64d6dea5d63c6eb7d4698dccbe485f0ce249b511109df657848c511f0177e605"},
        "selected_case_ids": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^us005\\.hs\\.[0-9]{4}$"}}
      }
    },
    "frozen_cases": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/case"}},
    "additive_vectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "properties": {
      "type": "object", "additionalProperties": false,
      "required": ["valid_cases_split_at_every_byte", "split_point_executions", "case_permutation_properties", "fixed_seed"],
      "properties": {
        "valid_cases_split_at_every_byte": {"const": 4},
        "split_point_executions": {"const": 548},
        "case_permutation_properties": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "fixed_seed": {"const": "us010-client-handshake-properties-v1"}
      }
    },
    "fuzz_seeds": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/seed"}},
    "nonclaims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assurance": {"$ref": "#/$defs/assurance"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "client_key", "nonce_hex", "expected"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^us005\\.hs\\.[0-9]{4}$"},
        "client_key": {"type": "string", "minLength": 24, "maxLength": 24},
        "nonce_hex": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "expected": {"type": "string", "minLength": 1}
      }
    },
    "seed": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "expected"],
      "properties": {
        "path": {"type": "string", "pattern": "^rust/connection-core/fuzz-seeds/us010/[a-z-]+\\.hex$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "expected": {"type": "string", "minLength": 1}
      }
    },
    "assurance": {
      "type": "object", "additionalProperties": false,
      "required": ["assurance", "independent_review_claimed", "autobahn_executions", "production", "publication"],
      "properties": {
        "assurance": {"const": "OWNER_ATTESTED_NOT_INDEPENDENT"},
        "independent_review_claimed": {"const": false},
        "autobahn_executions": {"const": 0},
        "production": {"const": false},
        "publication": {"const": false}
      }
    }
  }
}
