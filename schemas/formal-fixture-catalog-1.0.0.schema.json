{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "formal-fixture-catalog-1.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "entity_type", "fixture_tree_algorithm", "assurance", "independent_review_claimed", "cases"],
  "properties": {
    "$schema": {"const": "../../../schemas/formal-fixture-catalog-1.0.0.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "entity_type": {"const": "FormalFixtureCatalog"},
    "fixture_tree_algorithm": {"const": "CANONICAL_PATH_SHA256_V1"},
    "assurance": {"const": "SYNTHETIC_NON_CLAIM"},
    "independent_review_claimed": {"const": false},
    "cases": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "claimScope": {"enum": ["BOUNDED_TEST_EVIDENCE", "SYSTEMATIC_CONCURRENCY_TESTING", "PROVED_MODEL", "UNAVAILABLE_BACKEND_BLOCKED", "FUTURE_PRODUCTION_REFINEMENT"]},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "mutation", "fixture_tree_digest", "expected_code", "expected_disposition", "expected_reason", "expected_exit", "expected_state", "expected_claim_scopes", "synthetic_non_claim"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "mutation": {"type": "string", "minLength": 1},
        "fixture_tree_digest": {"$ref": "#/$defs/digest"},
        "expected_code": {"enum": ["", "SEMANTIC_INCONSISTENCY"]},
        "expected_disposition": {"enum": ["", "BLOCK"]},
        "expected_reason": {"type": "string"},
        "expected_exit": {"type": "integer", "minimum": 0, "maximum": 1},
        "expected_state": {"const": "BLOCKED"},
        "expected_claim_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/claimScope"}},
        "synthetic_non_claim": {"const": true}
      }
    }
  }
}
