{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "formal-backend-qualification-1.0.0.schema.json",
  "title": "US-006 formal backend qualification (lane C)",
  "description": "Per-backend qualification records for the formal-verification backends of US-006. Outcome vocabulary is the foundation ProofObligation lattice verbatim (third_party/verified-java-to-rust-foundation/foundation/evidence.go); there is deliberately no skip value. Records may claim only as far as executions actually went.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "story",
    "lane",
    "assurance",
    "independent_review_claimed",
    "aggregate_state",
    "sandbox_profile",
    "canary_vocabulary",
    "backends",
    "foundation_binding",
    "honesty_notes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "formal-backend-qualification" },
    "story": { "const": "US-006" },
    "lane": { "const": "C" },
    "assurance": { "const": "OWNER_ATTESTED_NOT_INDEPENDENT" },
    "independent_review_claimed": { "const": false },
    "aggregate_state": {
      "enum": [
        "QUALIFICATION_PENDING_SBX_EXECUTION",
        "QUALIFIED_EXECUTED",
        "UNAVAILABLE_BACKEND_BLOCKED"
      ]
    },
    "sandbox_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_attempt_id",
        "receipt_reference",
        "acceptance_citations",
        "sbx_cli_version",
        "sbx_cli_commit",
        "sbx_cli_binary_digest",
        "sbx_daemon_version",
        "template_reference",
        "template_manifest_digest",
        "template_index_digest",
        "network_policy_digest",
        "sandbox_policy_digest",
        "profile_source_paths"
      ],
      "properties": {
        "accepted_attempt_id": { "type": "string", "minLength": 1 },
        "receipt_reference": { "type": "string", "minLength": 1 },
        "acceptance_citations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sbx_cli_version": { "type": "string", "minLength": 1 },
        "sbx_cli_commit": { "type": "string", "minLength": 1 },
        "sbx_cli_binary_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sbx_daemon_version": { "type": "string", "minLength": 1 },
        "template_reference": { "type": "string", "minLength": 1 },
        "template_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "template_index_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "network_policy_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sandbox_policy_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "profile_source_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "canary_vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "rust_envelope_kill_inventory", "mutants"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "rust_envelope_kill_inventory": { "type": "integer", "minimum": 0 },
        "mutants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "live_kill_evidence"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "live_kill_evidence": { "type": "string", "minLength": 1 },
              "kills": { "type": "integer", "minimum": 0 },
              "kill_breakdown": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "public": { "type": "integer", "minimum": 0 },
                  "hidden": { "type": "integer", "minimum": 0 },
                  "sealed": { "type": "integer", "minimum": 0 }
                }
              },
              "signature": { "type": "string" }
            }
          }
        }
      }
    },
    "backends": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/backend" }
    },
    "foundation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_plan",
        "outcome_lattice",
        "assurance_label_ceilings",
        "required_artifact_types",
        "evidence_run_completeness_fields"
      ],
      "properties": {
        "entity_plan": { "type": "string", "minLength": 1 },
        "outcome_lattice": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "assurance_label_ceilings": {
          "type": "object",
          "additionalProperties": { "enum": ["LAB", "CANDIDATE", "PUBLISHED"] }
        },
        "required_artifact_types": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "evidence_run_completeness_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "honesty_notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "outcome": {
      "enum": [
        "ProofEstablished",
        "BoundedCheckPassed",
        "model_observation",
        "trace_observation",
        "unsupported",
        "inconclusive",
        "stale",
        "disconnected"
      ]
    },
    "canaryStatus": {
      "enum": ["NOT_EXECUTED", "PASSED", "DETECTED", "SURVIVED", "FAILED"]
    },
    "probeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "exit_code", "stdout", "stderr"],
      "properties": {
        "argv": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "stdout_bytes": { "type": "integer", "minimum": 0 },
        "stderr_bytes": { "type": "integer", "minimum": 0 },
        "stdout_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "stderr_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "stdout_truncated": { "type": "boolean" },
        "stderr_truncated": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "stdout_truncated": { "const": true } }, "required": ["stdout_truncated"] },
          "then": { "required": ["stdout_sha256", "stdout_bytes"] }
        },
        {
          "if": { "properties": { "stderr_truncated": { "const": true } }, "required": ["stderr_truncated"] },
          "then": { "required": ["stderr_sha256", "stderr_bytes"] }
        }
      ]
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_id",
        "tool",
        "method",
        "claim_scope",
        "assurance_label_ceiling",
        "max_outcome_allowed",
        "selected",
        "selection_state",
        "availability_probe",
        "sbx_execution",
        "expected_property_inventory",
        "obligations",
        "canaries",
        "bounds",
        "assumptions",
        "provenance",
        "unsupported_constructs",
        "trusted_base",
        "required_artifacts",
        "outcomes_summary"
      ],
      "properties": {
        "backend_id": { "type": "string", "pattern": "^backend\\.[a-z0-9][a-z0-9.-]*$" },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind", "identity", "version_observed"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "identity": { "type": "string", "minLength": 1 },
            "upstream": { "type": "string" },
            "version_observed": { "type": "string", "minLength": 1 }
          }
        },
        "method": { "type": "string", "minLength": 1 },
        "claim_scope": {
          "enum": [
            "BOUNDED_EVIDENCE_ONLY",
            "PROVED_MODEL_ONLY",
            "SYSTEMATIC_CONCURRENCY_TESTING"
          ]
        },
        "assurance_label_ceiling": { "enum": ["observed", "differential", "bounded", "proved-model"] },
        "max_outcome_allowed": { "$ref": "#/$defs/outcome" },
        "selected": { "type": "boolean" },
        "selection_state": {
          "enum": [
            "SELECTED_EXECUTED",
            "QUALIFICATION_PENDING_SBX_EXECUTION",
            "UNAVAILABLE_BACKEND_BLOCKED",
            "ABSENT_NO_RETAINED_ARTIFACT"
          ]
        },
        "availability_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executed", "venue", "host", "probed_at", "probe_semantics", "commands", "verdict"],
          "properties": {
            "executed": { "type": "boolean" },
            "venue": { "enum": ["HOST", "SBX"] },
            "host": { "type": "string", "minLength": 1 },
            "probed_at": { "type": "string", "minLength": 1 },
            "probe_semantics": { "type": "string", "minLength": 1 },
            "commands": {
              "type": "array",
              "items": { "$ref": "#/$defs/probeCommand" }
            },
            "verdict": {
              "enum": [
                "AVAILABLE",
                "UNAVAILABLE_ON_HOST",
                "NOT_DECLARED_IN_WORKSPACE",
                "TOOL_UNAVAILABLE_ON_HOST_JVM_PRESENT",
                "ABSENT_NO_RETAINED_ARTIFACT"
              ]
            }
          }
        },
        "sbx_execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["EXECUTED", "NOT_EXECUTED"] },
            "reason": { "type": "string" },
            "required_profile": { "type": "string" },
            "receipt": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            },
            "evidence_run": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_revision",
                "specification_revision",
                "java_revision",
                "rust_revision",
                "java_semantic_ids",
                "rust_semantic_ids",
                "command",
                "working_directory",
                "tool_hashes",
                "container_hashes",
                "environment",
                "seed",
                "hardware",
                "assumptions",
                "bounds",
                "unsupported_constructs",
                "trusted_base",
                "exit_count",
                "obligation_count",
                "raw_log_ids",
                "artifact_ids",
                "normalized_diff_id",
                "counterexample_or_corpus_ids",
                "replay_command"
              ],
              "properties": {
                "source_revision": { "type": "string" },
                "specification_revision": { "type": "string" },
                "java_revision": { "type": "string" },
                "rust_revision": { "type": "string" },
                "java_semantic_ids": { "type": "array", "items": { "type": "string" } },
                "rust_semantic_ids": { "type": "array", "items": { "type": "string" } },
                "command": { "type": "string" },
                "working_directory": { "type": "string" },
                "tool_hashes": { "type": "array", "items": { "type": "string" } },
                "container_hashes": { "type": "array", "items": { "type": "string" } },
                "environment": { "type": "array", "items": { "type": "string" } },
                "seed": { "type": "string" },
                "hardware": { "type": "string" },
                "assumptions": { "type": "array", "items": { "type": "string" } },
                "bounds": { "type": "object" },
                "unsupported_constructs": { "type": "array", "items": { "type": "string" } },
                "trusted_base": { "type": "array", "items": { "type": "string" } },
                "exit_count": { "type": "integer", "minimum": 0 },
                "obligation_count": { "type": "integer", "minimum": 0 },
                "raw_log_ids": { "type": "array", "items": { "type": "string" } },
                "artifact_ids": { "type": "array", "items": { "type": "string" } },
                "normalized_diff_id": { "type": "string" },
                "counterexample_or_corpus_ids": { "type": "array", "items": { "type": "string" } },
                "replay_command": { "type": "string" }
              }
            }
          }
        },
        "expected_property_inventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["property_id", "description", "formal_claim_id"],
            "properties": {
              "property_id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "formal_claim_id": { "type": "string", "pattern": "^formal\\.[a-z0-9.-]+$" }
            }
          }
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "formal_claim_id",
              "java_authority",
              "required_outcome",
              "outcome",
              "production_link",
              "production_code_ids"
            ],
            "properties": {
              "id": { "type": "string", "pattern": "^obl\\.[a-z0-9][a-z0-9.-]*$" },
              "description": { "type": "string", "minLength": 1 },
              "formal_claim_id": { "type": "string", "pattern": "^formal\\.[a-z0-9.-]+$" },
              "java_authority": { "type": "string", "minLength": 1 },
              "required_outcome": { "$ref": "#/$defs/outcome" },
              "outcome": { "$ref": "#/$defs/outcome" },
              "production_link": {
                "type": "object",
                "additionalProperties": false,
                "required": ["planned_symbol", "rust_semantic_id", "resolver_status"],
                "properties": {
                  "planned_symbol": { "type": "string", "minLength": 1 },
                  "rust_semantic_id": { "type": "string", "minLength": 1 },
                  "resolver_status": {
                    "enum": ["RUST_IDENTITIES_NOT_YET_RESOLVER_VERIFIED", "RESOLVER_VERIFIED"]
                  }
                }
              },
              "production_code_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "canaries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["known_good", "known_bad"],
          "properties": {
            "known_good": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["id", "description", "status"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "status": { "$ref": "#/$defs/canaryStatus" }
              }
            },
            "known_bad": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["id", "mutant_id", "description", "expected_detection", "status"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "mutant_id": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "expected_detection": { "enum": ["COUNTEREXAMPLE"] },
                "status": { "$ref": "#/$defs/canaryStatus" },
                "counterexample_digest": { "type": "string" }
              }
            }
          }
        },
        "bounds": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": ["integer", "string"] }
        },
        "assumptions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "provenance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "unsupported_constructs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "trusted_base": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "required_artifacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "outcomes_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability_probe", "proof_obligations"],
          "properties": {
            "availability_probe": { "enum": ["EXECUTED", "NOT_EXECUTED"] },
            "proof_obligations": { "enum": ["EXECUTED", "NOT_EXECUTED"] }
          }
        }
      }
    }
  }
}
