        "transition": {"$ref": "#/$defs/transition"}, "close": {"$ref": "#/$defs/close"}, "error": {"$ref": "#/$defs/error"}, "transport": {"type": "string", "maxLength": 5592408}
      }
    },
    "rust_step": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "input_kind", "pre_state", "post_state", "consumed_bytes", "wire_buffered_bytes", "message_buffered_bytes", "observations"],
