      "properties": {"step": {"type": "integer", "minimum": 0, "maximum": 65535}, "from": {"$ref": "#/$defs/state"}, "to": {"$ref": "#/$defs/state"}}
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["actions", "buffered_bytes", "consumed_bytes", "frames", "input_bytes", "message_buffered_bytes", "wire_buffered_bytes"],
