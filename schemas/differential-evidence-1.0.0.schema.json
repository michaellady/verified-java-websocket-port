    "counts": {"type": "object", "additionalProperties": false, "required": ["scenarios", "java_primary", "java_replay", "rust_primary", "rust_replay", "processes", "flakes", "current_mismatches", "unresolved_differences", "normalization_collisions"], "properties": {"scenarios": {"const": 74}, "java_primary": {"const": 74}, "java_replay": {"const": 74}, "rust_primary": {"const": 74}, "rust_replay": {"const": 74}, "processes": {"const": 296}, "flakes": {"const": 0}, "current_mismatches": {"const": 0}, "unresolved_differences": {"const": 0}, "normalization_collisions": {"const": 0}}},
    "scenarios": {"type": "array", "minItems": 74, "maxItems": 74, "items": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "java_primary_sha256", "java_replay_sha256", "rust_primary_sha256", "rust_replay_sha256", "neutral_expected_sha256", "stable", "current_mismatch", "classification", "java_observation", "rust_observation", "rust_step_diagnostics", "rust_bootstrap_sha256", "java_normalization_loss", "rust_normalization_notes"], "properties": {"scenario_id": {"type": "string", "pattern": "^us005\\.pub\\.[0-9]{4}$"}, "java_primary_sha256": {"$ref": "#/$defs/digest"}, "java_replay_sha256": {"$ref": "#/$defs/digest"}, "rust_primary_sha256": {"$ref": "#/$defs/digest"}, "rust_replay_sha256": {"$ref": "#/$defs/digest"}, "neutral_expected_sha256": {"$ref": "#/$defs/digest"}, "stable": {"const": true}, "current_mismatch": {"const": false}, "classification": {"enum": ["agreement", "java_quirk"]}, "java_observation": {"$ref": "#/$defs/observation"}, "rust_observation": {"$ref": "#/$defs/observation"}, "rust_step_diagnostics": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/rust_step"}}, "rust_bootstrap_sha256": {"$ref": "#/$defs/digest"}, "java_normalization_loss": {"type": "array", "minItems": 5, "maxItems": 8192, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "rust_normalization_notes": {"type": "array", "maxItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 256}}}}},
    "processes": {"type": "array", "minItems": 296, "maxItems": 296, "items": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "runtime", "attempt", "pid", "executable_sha256", "stdin_sha256", "stdin_bytes", "stdout_sha256", "stdout_bytes", "stderr_sha256", "stderr_bytes", "exit_code", "started_unix_nano", "duration_nanos", "normalized_sha256"], "properties": {"scenario_id": {"type": "string", "pattern": "^us005\\.pub\\.[0-9]{4}$"}, "runtime": {"enum": ["java", "rust"]}, "attempt": {"enum": ["primary", "replay"]}, "pid": {"type": "integer", "minimum": 1}, "executable_sha256": {"$ref": "#/$defs/digest"}, "stdin_sha256": {"$ref": "#/$defs/digest"}, "stdin_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304}, "stdout_sha256": {"$ref": "#/$defs/digest"}, "stdout_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304}, "stderr_sha256": {"$ref": "#/$defs/digest"}, "stderr_bytes": {"type": "integer", "minimum": 0, "maximum": 4096}, "exit_code": {"const": 0}, "started_unix_nano": {"type": "integer", "minimum": 1}, "duration_nanos": {"type": "integer", "minimum": 0, "maximum": 5000000000}, "normalized_sha256": {"$ref": "#/$defs/digest"}}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["summary", "migration", "compatibility"], "properties": {"summary": {"type": "object", "additionalProperties": false, "required": ["migration_rows", "compatibility_items", "fresh_rows", "predecessor_rows", "capability_excluded_rows", "unresolved_rows"], "properties": {"migration_rows": {"const": 47}, "compatibility_items": {"const": 14}, "fresh_rows": {"type": "integer", "minimum": 1, "maximum": 61}, "predecessor_rows": {"type": "integer", "minimum": 1, "maximum": 61}, "capability_excluded_rows": {"type": "integer", "minimum": 0, "maximum": 61}, "unresolved_rows": {"const": 0}}}, "migration": {"type": "array", "minItems": 47, "maxItems": 47, "items": {"$ref": "#/$defs/coverage_row"}}, "compatibility": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/coverage_row"}}}},
    "controls": {"type": "object", "additionalProperties": false, "required": ["total", "killed", "results"], "properties": {"total": {"const": 7}, "killed": {"const": 7}, "results": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["control_id", "seed_sha256", "expected_code", "detected_code", "baseline_passed", "ledger_unchanged"], "properties": {"control_id": {"type": "string", "minLength": 1, "maxLength": 64}, "seed_sha256": {"$ref": "#/$defs/digest"}, "expected_code": {"type": "string", "minLength": 1, "maxLength": 64}, "detected_code": {"type": "string", "minLength": 1, "maxLength": 64}, "baseline_passed": {"const": true}, "ledger_unchanged": {"const": true}}}}}},
    "ledger": {"type": "object", "additionalProperties": false, "required": ["pre_head", "post_head", "records"], "properties": {"pre_head": {"$ref": "#/$defs/digest"}, "post_head": {"$ref": "#/$defs/digest"}, "records": {"type": "integer", "minimum": 0, "maximum": 4096}}},
    "nonclaims": {"type": "array", "minItems": 6, "maxItems": 32, "allOf": [{"contains": {"const": "no per-step Java counter parity"}}, {"contains": {"const": "input_bytes derives from public source kind plus Rust pre_state and typed INVALID_STATE; it is not raw NOBS1 accounting and cannot change consumed_bytes"}}], "items": {"type": "string", "minLength": 1, "maxLength": 256}}
  }
