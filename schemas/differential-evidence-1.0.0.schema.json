      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "reason", "clean", "origin"],
      "properties": {
        "code": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
        "reason": {"type": "string", "maxLength": 65535},
        "clean": {"type": "boolean"},
        "origin": {"enum": ["local", "remote", "transport", "unknown_before_scenario", "none"]}
      }
    },
    "error": {
      "type": ["object", "null"], "additionalProperties": false,
