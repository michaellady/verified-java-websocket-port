  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "evidence_id", "story_id", "status", "assurance", "independent_review_claimed", "production", "publication", "signing", "parity_scope", "repository_anchor", "inputs", "counts", "scenarios", "processes", "coverage", "controls", "ledger", "nonclaims"],
  "properties": {
    "$schema": {"const": "../../schemas/differential-evidence-1.0.0.schema.json"}, "schema_version": {"const": "1.0.0"}, "evidence_id": {"const": "evidence.us-020-public-differential"}, "story_id": {"const": "US-020"}, "status": {"const": "PASS"},
