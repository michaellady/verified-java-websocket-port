{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michaellady.github.io/verified-java-to-rust/protocol/checkpoint-1.0.0.schema.json",
  "title": "Java-to-Rust Assurance Runner Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state_digest", "created_at", "state"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "state_digest": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "format": "date-time"},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "snapshot_id", "snapshot_digest", "status", "stages", "attempts", "failures", "completed_outputs", "applied_commands", "consumed_nonces", "checkpoint_verifications", "verification"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "snapshot_digest": {"$ref": "#/$defs/digest"},
        "status": {"enum": ["RUNNING", "BLOCKED", "QUARANTINED", "CANCELLED", "SUPERSEDED", "PROMOTED"]},
        "stages": {"type": "array"},
        "attempts": {"type": "array"},
        "failures": {"type": "array"},
        "completed_outputs": {"type": "array", "items": {"type": "string"}},
        "applied_commands": {"type": "object", "additionalProperties": {"$ref": "#/$defs/digest"}},
        "consumed_nonces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "checkpoint_verifications": {"type": "array", "items": {"$ref": "#/$defs/checkpointVerification"}},
        "verified_checkpoint": {"$ref": "#/$defs/digest"},
        "verified_by_command_id": {"type": "string", "minLength": 1},
        "verified_by_nonce": {"type": "string", "minLength": 1},
        "cancelled_at": {"type": "string", "format": "date-time"},
        "superseded_by": {"type": "string"},
        "promoted_digest": {"$ref": "#/$defs/digest"},
        "verification": {"$ref": "#/$defs/verificationReceipt"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "verificationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_digest", "policy_digest", "verifier_ids", "agreement_digest"],
      "properties": {
        "bundle_digest": {"$ref": "#/$defs/digest"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "verifier_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "agreement_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "role", "snapshot_roles", "snapshot_digest", "policy_version", "nonce", "prior_nonces", "issued_at", "expires_at", "signature_verified", "revoked", "command_id", "action", "intent_digest"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "snapshot_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "snapshot_digest": {"$ref": "#/$defs/digest"},
        "policy_version": {"type": "string", "minLength": 1},
        "nonce": {"type": "string", "minLength": 1},
        "prior_nonces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "signature_verified": {"type": "boolean"},
        "revoked": {"type": "boolean"},
        "command_id": {"type": "string", "minLength": 1},
        "action": {"const": "VERIFY_CHECKPOINT"},
        "stage_id": {"type": "string"},
        "intent_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "snapshot_id", "authorization", "occurred_at", "checkpoint_digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "VERIFY_CHECKPOINT"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "stage_id": {"type": "string"},
        "idempotency_key": {"type": "string"},
        "attempt_id": {"type": "string"},
        "run_id": {"type": "string"},
        "outcome": {"type": "string"},
        "error_type": {"type": "string"},
        "safe_message": {"type": "string"},
        "cause_chain": {"type": "array", "items": {"type": "string"}},
        "codepath": {"type": "string"},
        "severity": {"type": "string"},
        "diagnostic_artifact_id": {"type": "string"},
        "affected_claim_ids": {"type": "array", "items": {"type": "string"}},
        "affected_artifact_ids": {"type": "array", "items": {"type": "string"}},
        "authorization": {"$ref": "#/$defs/authorization"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "superseded_by": {"type": "string"},
        "checkpoint_digest": {"$ref": "#/$defs/digest"},
        "query_budget_consumed": {"type": "integer", "minimum": 0},
        "security_finding_ids": {"type": "array", "items": {"type": "string"}},
        "reviewer_interventions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "checkpointVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "pre_verification_state_digest", "verification"],
      "properties": {
        "command": {"$ref": "#/$defs/command"},
        "pre_verification_state_digest": {"$ref": "#/$defs/digest"},
        "verification": {"$ref": "#/$defs/verificationReceipt"}
      }
    }
  }
}
